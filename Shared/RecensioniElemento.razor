@using System.Globalization
@using Eton.Models
@inject ReviewRepository Repository
@inject SpaceRepository SpaziRepository
@inject AuthStateService AuthState

<section class="blocco-recensioni">
    <h2>Recensioni</h2>

    @if (!caricato)
    {
        <p class="avvio">Caricamento…</p>
    }
    else if (recensioniNonLette)
    {
        <div class="vuoto">
            <div class="errore" role="alert">@errore</div>
            <button class="btn" @onclick="Riprova">Riprova</button>
        </div>
    }
    else
    {
        @if (errore is not null)
        {
            <div class="errore" role="alert">@errore</div>
        }
        @if (avviso is not null)
        {
            <div class="avviso" role="status">@avviso</div>
        }

        <p class="riepilogo-voto">
            @if (Coperto)
            {
                <span class="voto-coperto">?</span>
                <span class="testo-tenue">/ @VotoMassimo — coperto finché non voti</span>
            }
            else if (altreNonLette)
            {
                @* Stesso "?" del caso coperto, e per la stessa ragione: la media calcolabile adesso
                   sarebbe quella della sola recensione appena scritta, indistinguibile a schermo da
                   una media di tutti. Un voto proprio mostrato come giudizio collettivo è peggio di
                   un punto interrogativo. *@
                <span class="voto-coperto">?</span>
                <span class="testo-tenue">/ @VotoMassimo — le altre recensioni non si sono lette</span>
            }
            else
            {
                <span class="voto-grande">@CalcoliVoti.Testo(Riepilogo.Media)</span>
                <span class="testo-tenue">/ @VotoMassimo — @TestoConteggio()</span>
            }
        </p>

        <div class="scheda">
            <h3>La tua recensione</h3>

            <VotoInput @bind-Voto="mioVoto" Massimo="VotoMassimo" Disabilitato="occupato" />

            <label class="campo">
                <span class="etichetta-piccola">Commento</span>
                <textarea maxlength="4000" rows="3" placeholder="Cosa ne pensi?"
                          @bind="mioCommento" @bind:event="oninput" disabled="@occupato"></textarea>
            </label>

            <div class="azioni">
                <button class="btn primario" @onclick="Salva" disabled="@(occupato || !Cambiata)">
                    @(occupato ? "Salvo…" : "Salva")
                </button>

                @if (mia is not null)
                {
                    @if (confermaEliminazione)
                    {
                        <button class="btn rosso" @onclick="Elimina" disabled="@occupato">Sì, togli</button>
                        <button class="btn" @onclick="() => confermaEliminazione = false" disabled="@occupato">Annulla</button>
                    }
                    else
                    {
                        <button class="btn rosso" @onclick="() => confermaEliminazione = true" disabled="@occupato">Togli la mia recensione</button>
                    }
                }
            </div>
        </div>

        @if (Coperto)
        {
            <div class="alla-cieca">
                <span class="quanti">@(recensori?.ToString() ?? "?")</span>
                <p>@TestoAllaCieca()</p>
            </div>
        }
        else if (altreNonLette)
        {
            <h3>Altre recensioni</h3>

            @* Un errore con Riprova, non un elenco vuoto: qui "vuoto" non significa "non c'è
               nessuno", significa "non lo so", e il vuoto muto dell'altro ramo direbbe la prima cosa
               al posto della seconda. Riprova ricarica tutto (v. Carica) — anche i nomi e il
               conteggio, che possono essere caduti insieme alle recensioni. *@
            <div class="vuoto">
                <div class="errore" role="alert">
                    La tua recensione è salvata, ma le altre non si sono lette.
                </div>
                <button class="btn" @onclick="Riprova">Riprova</button>
            </div>
        }
        else
        {
            <h3>Altre recensioni</h3>

            @* Ordine così com'è tornato da ElencaPerElementoAsync, cioè dalla prima recensione
               all'ultima: come una conversazione, non "le più recenti in cima" (v. il commento sul
               metodo in Services/ReviewRepository.cs). *@
            var altre = recensioni.Where(r => mia is null || r.Id != mia.Id).ToList();

            @if (altre.Count == 0)
            {
                <div class="vuoto">
                    <p>Ancora nessun'altra recensione.</p>
                </div>
            }
            else
            {
                @foreach (var r in altre)
                {
                    <div class="riga-recensione">
                        <span class="etichetta-piccola">@NomeAutore(r) · @Data(r)</span>

                        @* Senza "/ @VotoMassimo": la scala si dichiara una volta sola, in cima alla scheda
                           accanto alla media, e ripeterla su ogni riga la trasforma in rumore. Qui i voti
                           stanno incolonnati e devono restare larghi quanto la colonna (3.5rem), dove un
                           "/ 10" in più non ci sta. *@
                        <span class="voto-cifre">@CalcoliVoti.Testo(r.Rating)</span>

                        @* Testo semplice, non Markdown: a differenza delle note, un commento di recensione non
                           ha un editor con anteprima e non ci si aspetta formattazione — è un'opinione breve, non
                           un documento. @r.Comment dentro un elemento normale è già sicuro: Blazor lo codifica da
                           sé, senza bisogno di MarkdownRenderer né di un MarkupString. *@
                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                        {
                            <p>@r.Comment</p>
                        }
                    </div>
                }
            }
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid ElementoId { get; set; }
    [Parameter, EditorRequired] public Guid SpazioId { get; set; }
    [Parameter] public short VotoMassimo { get; set; } = 10;
    [Parameter] public bool AllaCieca { get; set; }

    private Guid? io;
    private IReadOnlyList<Review> recensioni = [];
    private Dictionary<Guid, string> nomiMembri = new();
    private Review? mia;
    private decimal? mioVoto;
    private string mioCommento = "";

    // Quante persone hanno recensito questo elemento, letto solo quando si è coperti (v. Coperto).
    // Null finché non lo si sa (non ancora chiesto, o chiesto e non riuscito): un intero, anche 0,
    // solo dopo una lettura andata a buon fine — per non confondere "non lo so" con "nessuno".
    //
    // "Recensori" e non "votanti" perché review_counts conta le righe, comprese quelle di solo
    // commento: è lo stesso insieme di persone che la propria recensione scopre (v. has_reviewed
    // nella migrazione), ed è per questo che il conteggio è fatto così. Il nome sbagliato inviterebbe
    // il prossimo a "correggerlo" verso i soli voti numerici, rompendo la corrispondenza.
    private int? recensori;

    // Distingue "questo elemento non ha altre recensioni" da "le altre non si sono rilette dopo che
    // la mia le ha scoperte". Su una collezione cieca la differenza è tutta: prima di votare
    // 'recensioni' è vuota PER REGOLA, quindi una rilettura fallita lascia in mano la sola recensione
    // appena scritta — che a schermo diventerebbe una media di tutti e un "ancora nessun'altra
    // recensione", entrambi falsi e indistinguibili dal vero. Stesso ragionamento di
    // recensioniNonLette, ma su una lettura che avviene a componente già caricato.
    private bool altreNonLette;

    private bool caricato, occupato, confermaEliminazione;

    // Distingue "questo elemento non ha ancora recensioni" da "le recensioni non sono riuscito a
    // leggerle": in entrambi i casi la lista è vuota, ma solo nel secondo va mostrato un errore
    // bloccante con un pulsante Riprova invece del contenuto. Stesso ragionamento di
    // Pages/Notes.razor (noteNonLette).
    private bool recensioniNonLette;

    private string? errore, avviso;
    private int generazione;

    private RiepilogoVoti Riepilogo => CalcoliVoti.PerElemento(recensioni, io);

    // Non un campo: 'mia' cambia durante la vita del componente (si vota, si toglie il voto) e un
    // campo si dimenticherebbe di seguirla. Coperti solo su una collezione alla cieca, e solo finché
    // non si è lasciata la propria recensione.
    private bool Coperto => AllaCieca && mia is null;

    // Il pulsante Salva resta spento finché non c'è niente da salvare, come in NoteEdit.Cambiata:
    // senza recensione propria, "cambiata" significa aver scritto qualcosa; con una recensione
    // propria, significa essersi discostati da ciò che il server ha in mano.
    private bool Cambiata => mia is null
        ? mioVoto is not null || !string.IsNullOrWhiteSpace(mioCommento)
        : mioVoto != mia.Rating || mioCommento != (mia.Comment ?? "");

    // Come in CollectionDetail: ElementoId cambia navigando da un elemento all'altro senza smontare
    // questo componente, quindi il ricaricamento va agganciato a OnParametersSetAsync e non a
    // OnInitializedAsync, e due caricamenti possono sovrapporsi con quello partito prima che
    // risponde per ultimo.
    protected override Task OnParametersSetAsync() => Carica();

    private async Task Carica()
    {
        var miaGenerazione = ++generazione;

        caricato = false;
        errore = avviso = null;
        recensioniNonLette = false;
        altreNonLette = false;

        io = null;
        recensioni = [];
        nomiMembri = new Dictionary<Guid, string>();
        mia = null;
        mioVoto = null;
        mioCommento = "";
        recensori = null;

        // Anche lo stato di interazione, non solo i dati: 'occupato' lasciato acceso da un
        // salvataggio partito sull'elemento precedente terrebbe il pulsante su "Salvo…" per un
        // elemento su cui non sta salvando niente, e 'confermaEliminazione' lasciata accesa
        // mostrerebbe "Sì, togli"/"Annulla" già aperti sulla recensione di un altro elemento, senza
        // che nessuno abbia chiesto di toglierla — un clic distratto la cancellerebbe.
        occupato = false;
        confermaEliminazione = false;

        try
        {
            var idTesto = await AuthState.GetUserIdAsync();
            if (miaGenerazione != generazione) return;

            if (Guid.TryParse(idTesto, out var utente)) io = utente;
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;
            errore = $"Non è stato possibile identificare l'utente corrente: {ex.Message}";
        }

        try
        {
            var elencate = await Repository.ElencaPerElementoAsync(ElementoId);
            if (miaGenerazione != generazione) return;

            recensioni = elencate;
            mia = io is null ? null : recensioni.FirstOrDefault(r => r.UserId == io);
            if (mia is not null)
            {
                mioVoto = mia.Rating;
                mioCommento = mia.Comment ?? "";
            }
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;
            errore = $"Non è stato possibile leggere le recensioni: {ex.Message}";
            recensioniNonLette = true;
            caricato = true;
            return;
        }

        // Try separato, e non insieme alle recensioni: i nomi dei membri servono soltanto a scrivere
        // l'autore accanto a ogni recensione altrui. Un fallimento qui degrada silenziosamente a "Un
        // membro" (v. NomeAutore) invece di un banner rosso, perché le recensioni restano perfettamente
        // leggibili senza — non è un errore da mostrare, ma va tracciato, altrimenti sparisce senza
        // lasciare traccia. Stesso ragionamento di Pages/Notes.razor.
        try
        {
            var membri = await SpaziRepository.MembriAsync(SpazioId);
            if (miaGenerazione != generazione) return;

            nomiMembri = membri.ToDictionary(m => m.UtenteId, m => m.Nome);
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;
            Console.Error.WriteLine($"[RecensioniElemento] Nomi degli autori non disponibili: {ex.Message}");
        }

        await LeggiRecensori(miaGenerazione);

        caricato = true;
    }

    // Quante persone hanno recensito questo elemento. In un try tutto suo, come il blocco dei nomi
    // qui sopra: un conteggio mancante non merita un banner rosso sopra recensioni che si leggono
    // benissimo. Chiesto solo quando si è coperti — su una collezione normale il numero si ricava
    // già dalle recensioni scaricate, e chiederlo sarebbe una richiesta di rete per un dato che si
    // ha in mano.
    private async Task LeggiRecensori(int miaGenerazione)
    {
        if (!Coperto) return;

        // Azzerato PRIMA di rileggere, non solo in cima a Carica(): questo metodo viene richiamato
        // anche dopo aver tolto la propria recensione, quando in 'recensori' c'è il numero letto
        // prima del voto. Se la lettura qui sotto fallisce, senza questa riga resterebbe a schermo
        // quel numero vecchio — un dato falso mostrato come vero, invece del "?" che dice "non lo so".
        recensori = null;

        try
        {
            var conteggi = await Repository.ConteggiPerSpazioAsync(SpazioId);
            if (miaGenerazione != generazione) return;

            recensori = conteggi.TryGetValue(ElementoId, out var n) ? n : 0;
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;
            Console.Error.WriteLine($"[RecensioniElemento] Conteggio dei recensori non disponibile: {ex.Message}");
        }
    }

    private Task Riprova() => Carica();

    // La generazione si cattura anche qui, non solo in Carica: una risposta di salvataggio che arriva
    // dopo che l'utente è passato a un altro elemento non deve scrivere niente. Senza queste guardie,
    // la risposta per l'elemento A imposterebbe 'mia', 'mioVoto' e 'mioCommento' con i dati di A
    // mentre a schermo c'è B — e il Salva successivo, che usa mia.Id, modificherebbe in silenzio la
    // recensione di A credendo di scrivere quella di B.
    private async Task Salva()
    {
        var miaGenerazione = generazione;
        errore = avviso = null;

        // Voto e commento entrambi vuoti: il database rifiuterebbe la riga (vincolo
        // reviews_non_vuota). Se esiste già una recensione, salvarla vuota equivarrebbe comunque a
        // cancellarla — meglio farlo esplicitamente. Se non esiste, non c'è niente da fare. In
        // nessuno dei due casi è un errore: è esattamente ciò che l'utente sta chiedendo.
        if (mioVoto is null && string.IsNullOrWhiteSpace(mioCommento))
        {
            if (mia is not null) await Elimina();
            return;
        }

        if (mia is null && io is null)
        {
            errore = "La sessione non è più valida: esci e rientra.";
            return;
        }

        occupato = true;
        try
        {
            // Catturato prima di Crea/Modifica: dopo, 'Coperto' riflette già l'esito, e il confronto
            // non direbbe più se qualcosa è cambiato.
            var eroCoperto = Coperto;

            if (mia is null) await Crea(miaGenerazione);
            else await Modifica(miaGenerazione);

            // Si rilegge quando la COPERTURA è cambiata, non quando è comparsa una recensione: sono
            // due condizioni che coincidono nel caso comune e divergono in quello che conta. La prima
            // recensione apre le altre; ma anche l'esito Sparita di Modifica — la propria recensione
            // cancellata da un altro dispositivo mentre la si stava modificando — riporta coperti, e
            // lascia in mano un elenco letto quando si era scoperti. Guardando "ho recensito adesso"
            // quel secondo caso sfuggiva. Una modifica riuscita non muove niente: coperto prima,
            // coperto dopo, o scoperto in entrambi i momenti.
            if (miaGenerazione == generazione && Coperto != eroCoperto)
                await RileggiSeCieca(miaGenerazione);
        }
        finally
        {
            // Se nel frattempo si è passati a un altro elemento, 'occupato' non è più nostro:
            // appartiene al caricamento nuovo, che l'ha già azzerato da sé in Carica().
            if (miaGenerazione == generazione) occupato = false;
        }
    }

    private async Task Crea(int miaGenerazione)
    {
        try
        {
            var creata = await Repository.CreaAsync(ElementoId, SpazioId, io!.Value, mioVoto, CommentoOrNull());
            if (miaGenerazione != generazione) return;

            Aggiorna(creata);
            avviso = "Salvata.";
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;

            // Il vincolo unique (item_id, user_id) vieta una seconda recensione della stessa persona
            // sullo stesso elemento: se questa INSERT è fallita perché una c'era già — scritta da te
            // da un'altra scheda dopo che questa pagina aveva caricato — il messaggio grezzo di
            // Postgres non aiuterebbe nessuno, e ripremere Salva ripeterebbe lo stesso errore
            // all'infinito, perché 'mia' resterebbe null e si tenterebbe di nuovo una INSERT. Una
            // seconda lettura dice quale dei due casi è, come fa ReviewRepository.SalvaAsync per
            // distinguere conflitto, rifiuto e riga sparita.
            var elencate = await RiletturaSilenziosa();
            if (miaGenerazione != generazione) return;

            var esistente = elencate?.FirstOrDefault(r => r.UserId == io);
            if (esistente is null)
            {
                errore = $"Non è stato possibile salvare: {ex.Message}";
                return;
            }

            // Voto e commento appena digitati NON si sovrascrivono con quelli letti: quello che
            // l'utente ha scritto non va perso per un salvataggio fallito. Si aggiorna solo 'mia',
            // così il prossimo Salva è una modifica di quella riga invece di un'altra INSERT
            // destinata a fallire allo stesso modo.
            recensioni = elencate!;
            mia = esistente;
            avviso = "Avevi già recensito questo elemento altrove: ho caricato quella recensione senza toccare ciò che hai appena scritto. Premi Salva di nuovo per sostituirla.";
        }
    }

    private async Task Modifica(int miaGenerazione)
    {
        try
        {
            var esito = await Repository.SalvaAsync(mia!.Id, mia.Version, mioVoto, CommentoOrNull());
            if (miaGenerazione != generazione) return;

            switch (esito.Esito)
            {
                case EsitoSalvataggio.Salvata:
                    Aggiorna(esito.Aggiornata!);
                    avviso = "Salvata.";
                    break;

                case EsitoSalvataggio.Conflitto:
                    // A differenza di Note e Collezioni, qui un conflitto non può nascere da un altro
                    // utente: la policy reviews_update permette di modificare solo la propria riga.
                    // Un conflitto significa quindi che l'hai salvata TU da un altro dispositivo — non
                    // c'è una scelta da fare fra "ricarica" e "sovrascrivi", si ricarica e basta.
                    Aggiorna(esito.Aggiornata!);
                    avviso = "La tua recensione era stata modificata altrove: ho caricato la versione più recente.";
                    break;

                case EsitoSalvataggio.Rifiutata:
                    errore = "Il database ha rifiutato la modifica.";
                    break;

                case EsitoSalvataggio.Sparita:
                    mia = null;
                    mioVoto = null;
                    mioCommento = "";
                    errore = "La tua recensione non c'è più.";
                    break;
            }
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;
            errore = $"Non è stato possibile salvare: {ex.Message}";
        }
    }

    // Rilettura di servizio, usata solo per capire com'è finita una scrittura fallita: un errore qui
    // non va mostrato, perché il messaggio che l'utente legge è quello della scrittura, non quello
    // del tentativo di spiegarla. Va però tracciato, altrimenti una rilettura che fallisce sempre
    // resterebbe indistinguibile da "nessuna recensione trovata".
    private async Task<IReadOnlyList<Review>?> RiletturaSilenziosa()
    {
        try
        {
            return await Repository.ElencaPerElementoAsync(ElementoId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[RecensioniElemento] Rilettura dopo una scrittura fallita non riuscita: {ex.Message}");
            return null;
        }
    }

    // Su una collezione cieca la propria recensione è l'interruttore di ciò che si vede: metterla apre
    // le altre, toglierla le richiude. In entrambi i casi l'elenco in memoria è quello di prima, letto
    // sotto una regola che nel frattempo è cambiata.
    private async Task RileggiSeCieca(int miaGenerazione)
    {
        if (!AllaCieca) return;

        var elencate = await RiletturaSilenziosa();
        if (miaGenerazione != generazione) return;

        // Il fallimento va registrato, non ignorato: senza, si uscirebbe lasciando a schermo
        // l'elenco di prima come se fosse quello di adesso. È l'unica lettura del componente che,
        // fallendo, produce un contenuto plausibile invece di un contenuto assente — v. altreNonLette.
        // Non azzerato in un finally: quando la generazione è cambiata questo stato non è più nostro,
        // l'ha già rimesso a posto il caricamento nuovo.
        if (elencate is null)
        {
            altreNonLette = true;

            // Decade anche il conteggio, che non viene riletto qui sotto: quello in mano è il numero
            // di prima del voto. Dopo un'eliminazione — che riporta coperti, e il conteggio torna
            // l'unica cosa a schermo — resterebbe lì come se fosse fresco.
            recensori = null;
            return;
        }

        altreNonLette = false;
        recensioni = elencate;

        // Dopo un'eliminazione si torna coperti, e il conteggio è di nuovo l'unica cosa visibile: va
        // riletto. Dopo una prima recensione si è appena scoperti, e LeggiRecensori esce da sé senza
        // toccare la rete.
        await LeggiRecensori(miaGenerazione);
    }

    // Sostituisce la riga se c'è già, la aggiunge se non c'è: dopo una modifica la recensione è
    // nell'elenco caricato, dopo una creazione no, e senza il ramo dell'aggiunta la propria
    // recensione appena creata non comparirebbe nella media né nel conteggio finché non si ricarica.
    private void Aggiorna(Review aggiornata)
    {
        recensioni = recensioni.Any(r => r.Id == aggiornata.Id)
            ? recensioni.Select(r => r.Id == aggiornata.Id ? aggiornata : r).ToList()
            : [.. recensioni, aggiornata];

        mia = aggiornata;
        mioVoto = aggiornata.Rating;
        mioCommento = aggiornata.Comment ?? "";
    }

    private string? CommentoOrNull() => string.IsNullOrWhiteSpace(mioCommento) ? null : mioCommento;

    private async Task Elimina()
    {
        if (mia is null) return;

        // Stesse guardie di Salva, e per lo stesso motivo: un'eliminazione partita sull'elemento A che
        // risponde dopo il passaggio a B azzererebbe voto e commento che l'utente sta scrivendo per B.
        var miaGenerazione = generazione;
        var id = mia.Id;

        occupato = true; errore = null;
        try
        {
            var eliminata = await Repository.EliminaAsync(id);
            if (miaGenerazione != generazione) return;

            if (eliminata)
            {
                recensioni = recensioni.Where(r => r.Id != id).ToList();
                mia = null;
                mioVoto = null;
                mioCommento = "";
                avviso = "Recensione eliminata.";

                await RileggiSeCieca(miaGenerazione);
            }
            else
            {
                errore = "Il database ha rifiutato l'eliminazione.";
            }
        }
        catch (Exception ex)
        {
            if (miaGenerazione != generazione) return;
            errore = $"Non è stato possibile eliminare: {ex.Message}";
        }
        finally
        {
            if (miaGenerazione == generazione)
            {
                occupato = false;
                confermaEliminazione = false;
            }
        }
    }

    private string NomeAutore(Review r) => nomiMembri.TryGetValue(r.UserId, out var nome) ? nome : "Un membro";

    private static string Data(Review r) => r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);

    private string TestoConteggio()
    {
        var votoParte = CalcoliVoti.TestoVoti(Riepilogo.Voti);

        // I commenti si contano sempre, non solo quando nessuno ha votato: con tre voti e due
        // recensioni di solo commento, fermarsi a "3 voti" tace metà di chi si è espresso, e il
        // riepilogo diventa asimmetrico — lo stesso dato comparirebbe o sparirebbe a seconda che
        // esista o no un voto.
        //
        // Si contano i commenti veri, non le righe senza voto: una recensione può avere entrambi, e
        // contare solo quelle senza voto sotto-stimerebbe i commenti ogni volta che qualcuno ha
        // votato E scritto. Nel caso "nessun voto" i due conteggi coincidono comunque, perché il
        // vincolo reviews_non_vuota impedisce una riga senza voto e senza commento.
        var commenti = recensioni.Count(r => !string.IsNullOrWhiteSpace(r.Comment));
        return commenti == 0 ? votoParte : $"{votoParte}, {commenti} {(commenti == 1 ? "commento" : "commenti")}";
    }

    // Testo del riquadro alla cieca: dice che le altre recensioni esistono ma restano coperte, e cosa
    // fare per scoprirle. Con zero non c'è niente di coperto — non è un errore, è il caso più comune
    // all'inizio, e dirlo come se ci fosse sarebbe falso. Con il conteggio non arrivato (v.
    // LeggiRecensori) il numero non si cita: uno indovinato sarebbe peggio di nessuno.
    //
    // "Hanno recensito", non "hanno votato": il conteggio comprende chi ha lasciato solo un commento
    // (v. CalcoliVoti.TestoRecensioni). Chiamarlo voto direbbe una cosa che il riepilogo smentisce un
    // istante dopo, quando l'elemento si scopre e quella persona finisce fra i commenti.
    //
    // Non usa CalcoliVoti.TestoRecensioni, che pure conta la stessa cosa: quello dice «3 recensioni»,
    // qui si contano PERSONE, e attorno al numero si accordano tre parole — «la sua recensione»
    // contro «le loro recensioni», «scoprirla» contro «scoprirle». Riusarlo significherebbe
    // incastrare «3 recensioni» dentro una frase che poi va comunque declinata a parte: una
    // duplicazione tolta a metà, in cambio di un testo peggiore.
    private string TestoAllaCieca() => recensori switch
    {
        null => "Le altre recensioni sono coperte finché non lasci la tua: vota per scoprirle.",
        0 => "Nessuno ha ancora recensito questo elemento.",
        1 => "1 persona ha recensito, ma la sua recensione resta coperta finché non lasci la tua: vota per scoprirla.",
        _ => $"{recensori} persone hanno recensito, ma le loro recensioni restano coperte finché non lasci la tua: vota per scoprirle.",
    };
}
