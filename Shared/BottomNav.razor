@inject NavigationManager Navigation

<nav class="barra-basso">
    @foreach (var voce in Voci)
    {
        <a href="@voce.Rotta" class="voce @(EAttiva(voce.Rotta) ? "attiva" : "")">
            <span class="icona"><Icona Nome="@voce.Icona" /></span>
            <span class="etichetta">@voce.Testo</span>
        </a>
    }
</nav>

@code {
    // Icona è il nome di un disegno di Shared/Icona.razor, non più un'emoji: v. il commento in
    // testa a quel file per il perché.
    private sealed record Voce(string Rotta, string Icona, string Testo);

    private static readonly Voce[] Voci =
    [
        new("", "casa", "Home"),
        new("notes", "note", "Note"),
        new("collections", "collezioni", "Collezioni"),
        new("spaces", "gruppo", "Spazi"),
        new("profile", "persona", "Profilo"),
    ];

    private bool EAttiva(string rotta)
    {
        var corrente = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var i = corrente.IndexOf('?');
        if (i >= 0) corrente = corrente[..i];

        // La Home è l'unica rotta vuota: senza questo caso a parte risulterebbe attiva sempre,
        // perché ogni percorso "comincia per" stringa vuota.
        return rotta.Length == 0 ? corrente.Length == 0 : corrente.StartsWith(rotta, StringComparison.Ordinal);
    }
}
