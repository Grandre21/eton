@inject NavigationManager Navigation
@implements IDisposable

@* Una sola barra, due forme. Sul telefono è la striscia in fondo allo schermo, dove arriva il
   pollice; su schermo largo diventa la colonna a sinistra, dove l'occhio cerca la navigazione.
   A cambiare è solo il CSS (v. la media query in fondo a wwwroot/css/app.css): due componenti
   separati avrebbero significato due elenchi di voci da tenere allineati a mano, e la voce
   aggiunta in uno solo dei due è esattamente il genere di svista che non si nota finché qualcuno
   non usa l'altro schermo.

   Marchio e piede esistono solo nella forma larga — sul telefono la striscia ha spazio per cinque
   voci e nient'altro, oggi Home, Note, Collezioni, Spese e Spazi — ma stanno comunque nel markup:
   nasconderli in CSS costa una riga, mentre renderli condizionalmente in C# vorrebbe dire
   conoscere la larghezza della finestra dentro l'applicazione, cioè interrogare il browser e
   ridisegnare a ogni ridimensionamento per ottenere quello che una media query fa da sola.

   Il Profilo non è fra queste cinque: ci si arriva poche volte l'anno, e quando capita è quasi
   sempre per uscire (v. il commento nel catch di OnInitializedAsync in Pages/Profile.razor: senza
   nome ed email il pulsante «Esci» funziona comunque, ed è l'unica cosa per cui si arriva davvero
   su quella pagina), mentre le spese si segnano tutti i giorni, e una sesta icona su un
   telefono stretto sarebbe illeggibile. Resta comunque raggiungibile da entrambe le forme, con due
   agganci e non uno solo, perché le due forme della barra si escludono a vicenda e un solo
   collegamento ne lascerebbe fuori metà degli schermi: qui sotto, accanto al SelettoreSpazio, per
   lo schermo largo; nella testata "solo-stretto" di Pages/Home.razor per il telefono, dove
   nav-piede non esiste. *@
<nav class="nav-app" aria-label="Navigazione principale">
    <div class="nav-marchio">Eton</div>

    <div class="nav-voci">
        @foreach (var voce in Voci)
        {
            var attiva = EAttiva(voce.Rotta);
            <a href="@voce.Rotta" class="voce @(attiva ? "attiva" : "")" aria-current="@(attiva ? "page" : null)">
                <span class="icona"><Icona Nome="@voce.Icona" /></span>
                <span class="etichetta">@voce.Testo</span>
            </a>
        }
    </div>

    <div class="nav-piede">
        <SelettoreSpazio />
        <a href="profile" class="voce-piede">
            <span class="icona"><Icona Nome="persona" /></span>
            <span class="etichetta">Profilo</span>
        </a>
    </div>
</nav>

@code {
    // Icona è il nome di un disegno di Shared/Icona.razor, non più un'emoji: v. il commento in
    // testa a quel file per il perché.
    private sealed record Voce(string Rotta, string Icona, string Testo);

    private static readonly Voce[] Voci =
    [
        new("", "casa", "Home"),
        new("notes", "note", "Note"),
        new("collections", "collezioni", "Collezioni"),
        new("expenses", "spese", "Spese"),
        new("spaces", "gruppo", "Spazi"),
    ];

    // Inizializzata subito per sottoscriversi a LocationChanged: EAttiva legge Navigation.Uri al
    // momento del render, quindi questo componente deve ridisegnarsi a ogni navigazione, e non può
    // affidarsi al ridisegno del genitore MainLayout per riceverlo — v. il commento su EAttiva più
    // sotto per il perché quella strada non funziona.
    protected override void OnInitialized() => Navigation.LocationChanged += SuCambioRotta;

    // Avvolto in InvokeAsync per lo stesso motivo di Layout/MainLayout.razor:60-70 e
    // Shared/SelettoreSpazio.razor:59-61: qui non servirebbe, perché Eton gira in WebAssembly a
    // thread singolo, ma resterebbe corretto se un domani il progetto abilitasse i thread.
    private void SuCambioRotta(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    // Legge Navigation.Uri al momento del render, quindi questo componente deve ridisegnarsi a ogni
    // navigazione perché la voce accesa sia corretta — ed è per questo che si sottoscrive da sé a
    // LocationChanged (v. OnInitialized sopra), invece di contare sul ridisegno del genitore
    // Layout/MainLayout.razor quando il suo '@key' cambia (v. quel file, righe 21-29).
    //
    // Contare sul genitore non funzionerebbe comunque: verificato decompilando
    // RenderTreeDiffBuilder.AppendDiffEntriesForRange in Microsoft.AspNetCore.Components 10.0.10
    // (via ilspycmd). Quando MainLayout si ridisegna e il diffing arriva al frame Component di
    // '<Navigazione />', che non ha parametri, confronta i parametri vecchi e nuovi — entrambi
    // vuoti — con ParameterView.DefinitelyEquals, che in questo caso risulta sempre true; e il
    // codice chiama SetDirectParameters solo quando quel confronto è false:
    // "if (!directParameters.DefinitelyEquals(oldParameters) | flag)
    // { componentState.SetDirectParameters(directParameters); }". Per un componente senza
    // parametri quella chiamata — e con essa SetParametersAsync e StateHasChanged — non parte mai,
    // per nessuna navigazione, anche quando il genitore si è davvero ridisegnato.
    //
    // Il difetto che ne nasceva: la voce accesa restava ferma su "Home" — la rotta d'ingresso — su
    // qualunque destinazione raggiunta cliccando i link della barra stessa, e solo un ricaricamento
    // a pagina intera la correggeva (confermato nel browser, build b5bcece). È il genere di difetto
    // che sfugge a chi verifica ricaricando: il primo render è sempre corretto, perché legge
    // Navigation.Uri da capo.
    private bool EAttiva(string rotta)
    {
        var corrente = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var i = corrente.IndexOf('?');
        if (i >= 0) corrente = corrente[..i];

        // La Home è l'unica rotta vuota: senza questo caso a parte risulterebbe attiva sempre,
        // perché ogni percorso "comincia per" stringa vuota.
        return rotta.Length == 0 ? corrente.Length == 0 : corrente.StartsWith(rotta, StringComparison.Ordinal);
    }

    // NavigationManager vive quanto l'applicazione, non quanto questo componente: senza questa
    // disiscrizione l'handler terrebbe in vita Navigazione per sempre. In pratica questo componente
    // è renderizzato una volta sola e non si smonta mai finché l'app è aperta, quindi Dispose oggi
    // non scatta — ma è il contratto di chi si sottoscrive, ed è quello che tiene la barra corretta
    // il giorno in cui qualcuno la rendesse condizionale.
    public void Dispose() => Navigation.LocationChanged -= SuCambioRotta;
}
