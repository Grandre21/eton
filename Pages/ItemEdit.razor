@page "/collections/{Id:guid}/items/new"
@page "/collections/{Id:guid}/items/{ItemId:guid}"
@using Eton.Models
@using Eton.Services
@inherits PaginaEditor
@inject CollectionRepository CollectionRepository
@inject CollectionItemRepository Repository
@inject SpaceStateService Spazi
@inject AuthStateService AuthState

<PageTitle>@TitoloSchermata — Eton</PageTitle>

<TestataPagina Titolo="@TitoloSchermata">
    <Aiuto>
        <p>Nei campi della collezione un valore che non si riesce a interpretare — per esempio un numero con delle lettere dentro — non viene salvato: il salvataggio riesce lo stesso, e quel campo torna vuoto.</p>
        <p>Se qualcun altro salva questo elemento mentre lo stai modificando, il salvataggio si ferma e ti fa scegliere fra ricaricare la sua versione e sovrascrivere con la tua.</p>
        <p>Uscendo con modifiche non salvate arriva una domanda: il lavoro in corso non si perde per sbaglio.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <p class="avvio">Caricamento…</p>
}
else if (sparito)
{
    <div class="vuoto">
        <p>Questo elemento non esiste più, o non fai più parte dello spazio che conteneva la collezione.</p>
        <a class="btn" href="collections/@Id">Torna alla collezione</a>
    </div>
}
else if (collezione is null)
{
    @* Ramo distinto da 'sparito', e non lo stesso flag: qui il primo caricamento è fallito, quindi
       NON sappiamo se l'elemento esista. Dire "non esiste più" per una rete caduta sarebbe
       un'affermazione falsa su un fatto che non conosciamo, e lascerebbe l'utente col solo
       "Torna alla collezione" invece che con un pulsante che ritenta. È anche questo ramo — non un
       flag nel catch — a impedire che Crea() parta con 'collezione' nulla: senza il contenuto a
       schermo, il pulsante Salva non esiste. Stessa forma di Home.razor:16-22. *@
    <div class="vuoto">
        <div class="errore" role="alert">@errore</div>
        <button class="btn" @onclick="Riprova">Riprova</button>
    </div>
}
else
{
    <NavigationLock ConfirmExternalNavigation="@Cambiata" OnBeforeInternalNavigation="GuardaUscita" />

    @if (conflitto is not null)
    {
        @* !PuoIntervenire in più: anche Sovrascrivi scrive nel database, e la RLS la
           rifiuterebbe agli stessi soggetti a cui Salva è vietato — v. il commento su
           PuoIntervenire più sotto. Stesso trattamento di SpesaEdit.razor. *@
        <SchedaConflitto Premessa="Mentre modificavi, questo elemento è cambiato." Occupato="@occupato" SovrascriviAbilitato="@PuoIntervenire"
                         OnRicarica="Ricarica" OnSovrascrivi="Sovrascrivi" />
    }

    @* PuoIntervenire (v. @code) decide se questi campi si possono toccare. Sotto la spiegazione e
       non sopra: chi legge dall'alto trova prima i dati dell'elemento, poi capisce perché non può
       cambiarli. *@
    @if (!PuoIntervenire)
    {
        <p class="spiega">@Permessi.Spiegazione(Permessi.Oggetto.Elemento)</p>
    }

    <input class="titolo-grande" type="text" placeholder="Nome dell'elemento" maxlength="200"
           @bind="nome" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />

    <label class="campo">
        <span class="etichetta-piccola">Immagine (indirizzo)</span>
        <input type="url" maxlength="2000" @bind="immagine" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />
    </label>

    @if (MarkdownRenderer.UrlAmmessa(immagine))
    {
        <img class="anteprima-immagine" src="@immagine" alt="" />
    }
    else if (!string.IsNullOrWhiteSpace(immagine))
    {
        <p class="testo-tenue">Indirizzo non utilizzabile: servono http o https.</p>
    }

    @if (campi.Count == 0)
    {
        <p class="testo-tenue">Questa collezione non ha ancora campi. <a href="collections/@Id/edit">Aggiungine</a>.</p>
    }
    else
    {
        @foreach (var campo in campi)
        {
            @* @key sull'oggetto e non su campo.Key: CampoDefinizione è una class senza override di
               Equals, quindi Blazor la confronta per riferimento e due campi restano distinti anche
               se il jsonb 'fields' porta due volte la stessa chiave — cosa che il vincolo SQL non
               impedisce. Con la chiave duplicata, @key="campo.Key" farebbe fallire il render
               dell'intera pagina. *@
            <CampoInput @key="campo" Campo="campo" Valore="@valori.GetValueOrDefault(campo.Key, "")"
                        ValoreChanged="@(v => valori[campo.Key] = v)" Disabilitato="@(occupato || !PuoIntervenire)" />
        }
    }

    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }
    @if (avviso is not null)
    {
        <div class="avviso" role="status">@avviso</div>
    }

    @* Perché il pulsante è spento, e solo quando non è già scritto altrove: 'occupato' lo dice il
       pulsante stesso, che intanto legge «Salvo…»; '!PuoIntervenire' lo dice la riga .spiega in
       cima alla pagina; il conflitto lo dice SchedaConflitto. Resta scoperto solo !Cambiata, che
       oggi non lascia niente da leggere e si scopre per tentativi.
       'testo-tenue' e non 'errore-campo': è un'istruzione, non un rimprovero — su .../items/new il
       modulo nasce vuoto per costruzione, e accoglierlo con una riga rossa darebbe la colpa di un
       errore a chi non ha ancora fatto niente. Stessa forma di Pages/CollectionEdit.razor. *@
    @if (!occupato && PuoIntervenire && conflitto is null && !Cambiata)
    {
        <p class="testo-tenue">
            @(Nuovo
                ? "Scrivi il nome dell'elemento per poterlo salvare."
                : "Non c'è niente da salvare: non hai ancora cambiato niente.")
        </p>
    }

    <div class="azioni">
        @* Anche 'conflitto is null', per lo stesso motivo del commento gemello in
           Pages/NoteEdit.razor: con la scheda del conflitto aperta il pulsante resterebbe acceso,
           perché lo stato è davvero diverso da quello di 'elemento'. Ripremerlo risalverebbe con la
           versione vecchia — stesso conflitto, altro giro a vuoto — e scavalcherebbe in silenzio la
           scelta fra Ricarica e Sovrascrivi, che è l'unico modo di uscirne. *@
        <button class="btn primario" @onclick="Salva" disabled="@(occupato || !Cambiata || conflitto is not null || !PuoIntervenire)">
            @(occupato ? "Salvo…" : "Salva")
        </button>
        <a class="btn" href="@(occupato ? null : $"collections/{Id}")">Chiudi</a>

        @* Elimina non compare affatto quando PuoIntervenire è falso, non solo disabilitato: v. il
           commento su PuoIntervenire più sotto per il perché — un pulsante grigio inviterebbe
           comunque a chiedersi il motivo, e qui la risposta non starebbe da nessuna parte. *@
        @if (!Nuovo && PuoIntervenire)
        {
            <ConfermaAzione Chiave="@ItemId" Occupato="@occupato" OnConferma="Elimina" />
        }
    </div>

    @* !Nuovo, non cosmetico: su /items/new l'elemento non esiste ancora, quindi ItemId è null e non
       c'è niente da recensire. Senza la guardia, ItemId!.Value lancerebbe. *@
    @if (!Nuovo && collezione is not null)
    {
        <RecensioniElemento ElementoId="ItemId!.Value"
                            SpazioId="collezione.SpaceId"
                            VotoMassimo="collezione.RatingMax"
                            AllaCieca="collezione.Blind" />
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public Guid? ItemId { get; set; }

    private Collection? collezione;
    private CollectionItem? elemento;   // l'ultima versione conosciuta dal server: da qui esce la versione
    private CollectionItem? conflitto;  // la versione altrui, quando il salvataggio si è scontrato
    private string nome = "";
    private string immagine = "";
    private readonly Dictionary<string, string> valori = new();
    private Dictionary<string, string> valoriIniziali = new();
    private IReadOnlyList<CampoDefinizione> campi = [];
    private bool caricato, occupato, sparito;
    private string? errore, avviso;
    private int generazione;

    // Come mioId in SpesaEdit.razor: GetUserIdAsync() più Guid.TryParse, popolato dentro Carica()
    // (v. sotto) e non in OnInitializedAsync, perché qui non esiste — la pagina è rilanciata da
    // OnParametersSetAsync anche quando Blazor riusa questa istanza da .../items/new a
    // .../items/{id}, e Carica() è il punto unico da cui passa ogni caricamento.
    private Guid? mioId;

    private bool Nuovo => ItemId is null;

    private string TitoloSchermata => string.IsNullOrWhiteSpace(nome) ? "Elemento" : nome;

    // La regola è comune a quattro entità (note, collezioni, elementi di collezione, spese): v.
    // Services/Permessi.cs per il perché di ogni scelta — perché non è un controllo di sicurezza,
    // perché guarda Spazi.Elenco e non Spazi.Attivo, perché fallisce chiuso, e perché non si
    // applica alle recensioni. Nuovo per primo: su .../items/new l'elemento non esiste ancora, e
    // chiedere "sei tu l'autore?" di un oggetto non creato risponderebbe no, bloccando la creazione.
    private bool PuoIntervenire => Nuovo
        || (elemento is not null && Permessi.PuoIntervenire(mioId, elemento.AddedBy, elemento.SpaceId, Spazi.Elenco));

    // Come il pulsante Salva di NoteEdit e CollectionEdit: resta spento finché non c'è niente da
    // salvare. Per un elemento nuovo basta il nome, come negli altri due editor.
    protected override bool Cambiata => Nuovo
        ? !string.IsNullOrWhiteSpace(nome)
        : elemento is not null && (
            nome != elemento.Name ||
            immagine != (elemento.ImageUrl ?? "") ||
            campi.Any(c => valori.GetValueOrDefault(c.Key, "") != valoriIniziali.GetValueOrDefault(c.Key, "")));

    // Come in NoteEdit e CollectionEdit: passando da .../items/new a .../items/{id} dopo la
    // creazione Blazor riusa QUESTA istanza e cambia solo il parametro, quindi due caricamenti
    // possono sovrapporsi e quello partito prima può rispondere per ultimo.
    protected override Task OnParametersSetAsync() => Carica();

    // Estratto da OnParametersSetAsync per poterlo richiamare da Riprova: un primo caricamento
    // fallito deve poter essere ritentato senza costringere l'utente a ricaricare la pagina.
    private async Task Carica()
    {
        var mia = ++generazione;

        caricato = false;
        errore = avviso = null;
        conflitto = null;
        sparito = false;

        try
        {
            // PuoIntervenire fallisce chiuso: uno spazio assente da Spazi.Elenco vale "non posso",
            // indistinguibile da uno spazio non posseduto. Senza questa attesa, chi apre la pagina
            // da un collegamento diretto — prima che qualcos'altro carichi Spazi.Elenco — vedrebbe
            // nascosti i pulsanti anche se possiede lo spazio: peggio del messaggio che questa
            // pagina correggeva, perché un pulsante assente non spiega a nessuno cosa non va.
            await Spazi.AssicuraCaricatoAsync();
            if (Guid.TryParse(await AuthState.GetUserIdAsync(), out var id)) mioId = id;
            if (mia != generazione) return;

            // Prima la collezione: servono i suoi campi per sapere cosa mostrare, e ordina anche
            // quando è la stessa che era già mostrata, così un campo aggiunto o tolto nel frattempo
            // si riflette anche riaprendo lo stesso elemento.
            var lettaCollezione = await CollectionRepository.LeggiAsync(Id);
            if (mia != generazione) return;

            collezione = lettaCollezione;
            if (collezione is null)
            {
                sparito = true;
                caricato = true;
                return;
            }

            campi = SchemaCampi.Ordina(collezione.Fields);

            if (Nuovo)
            {
                elemento = null;
                nome = immagine = "";
                CaricaValori(null);
            }
            else
            {
                var lettoElemento = await Repository.LeggiAsync(ItemId!.Value);
                if (mia != generazione) return;

                elemento = lettoElemento;
                if (elemento is null)
                {
                    sparito = true;
                    caricato = true;
                    return;
                }

                nome = elemento.Name;
                immagine = elemento.ImageUrl ?? "";
                CaricaValori(elemento);
            }
        }
        catch (Exception ex)
        {
            if (mia != generazione) return;
            // Il testo dell'eccezione NON va all'utente: quando è una PostgrestException, Message è
            // il corpo JSON della risposta — SQLSTATE, nome della tabella e, sul 42501, perfino il
            // GRANT da eseguire, cioè istruzioni per un amministratore di database mostrate a chi
            // voleva solo aprire un elemento. In console ci va invece per intero, così la diagnosi
            // non si perde. Vale per tutti i catch qui sotto.
            Console.Error.WriteLine($"[Elemento] Apertura non riuscita: {ex.Message}");
            errore = "Non è stato possibile aprire l'elemento: può essere la connessione, oppure il tuo accesso a questo spazio che è cambiato. Riprova fra un momento.";

            // NON si accende 'sparito': quello significa "il database ha risposto che non c'è", e
            // qui il database non ha risposto affatto. Si azzera invece tutto ciò che era a schermo,
            // come fa l'azzeramento di 'nota' nel catch di OnParametersSetAsync di
            // Pages/NoteEdit.razor — e non per simmetria, ma perché tenere i dati precedenti è
            // attivamente pericoloso su questa pagina. Se il caricamento fallito è quello
            // dell'elemento B raggiunto da /items/A, 'elemento' resterebbe A mentre ItemId ormai
            // vale B: SalvaAsync riga 304 usa ItemId, non elemento.Id, quindi salvare scriverebbe i
            // dati di A dentro B. Il conflitto ottimistico non lo ferma, perché confronta versioni
            // di due righe diverse: se coincidono per caso — due elementi appena creati sono
            // entrambi a version 1 — la scrittura passa e l'utente non vede nessun errore.
            collezione = null;
            elemento = null;
            campi = [];
            valori.Clear();
        }

        caricato = true;
    }

    private Task Riprova() => Carica();

    // PerModifica, non Testo: Testo("Sì"/"No", ...) non è ciò che DaTesto sa rileggere, e caricare
    // così ogni casella Sì/No la azzererebbe al primo salvataggio (v. il commento di PerModifica).
    private void CaricaValori(CollectionItem? item)
    {
        valori.Clear();
        foreach (var campo in campi)
            // '?.' su Data e non solo su item: il vincolo collection_items_data_shape rifiuta un
            // data che non sia un oggetto, quindi Newtonsoft non dovrebbe mai sovrascrivere
            // l'inizializzatore con null — ma la difesa costa un carattere e l'alternativa è una
            // NullReferenceException dentro il ciclo, cioè la pagina rotta invece di un campo vuoto.
            valori[campo.Key] = ValoriElemento.PerModifica(item?.Data?.GetValueOrDefault(campo.Key), campo.Type);

        valoriIniziali = new Dictionary<string, string>(valori);
    }

    // Si parte da una copia di elemento.Data, non da un dizionario vuoto: se un campo viene tolto
    // dalla collezione, i valori già inseriti restano nel jsonb degli elementi — è la promessa che
    // CollectionEdit fa all'utente ("I valori già inseriti restano salvati ma non si vedranno
    // più"). Ricostruire 'data' dai soli campi attuali tradirebbe quella promessa al primo
    // salvataggio di un elemento qualunque, cancellando dati che si era detto di conservare.
    private Dictionary<string, object> CostruisciDati()
    {
        var dati = elemento is null
            ? new Dictionary<string, object>()
            : new Dictionary<string, object>(elemento.Data);

        foreach (var campo in campi)
        {
            // DaTesto restituisce null sia per un campo vuoto sia per uno non interpretabile (una
            // data scritta male, un numero con lettere dentro): in entrambi i casi la chiave viene
            // tolta. È coerente — non si salva un valore che non si è capito — ma vuol dire che
            // digitare "ieri" in un campo data non dà errore, semplicemente non salva niente.
            var valore = ValoriElemento.DaTesto(valori.GetValueOrDefault(campo.Key), campo.Type);
            if (valore is null) dati.Remove(campo.Key); else dati[campo.Key] = valore;
        }

        return dati;
    }

    private async Task Salva()
    {
        occupato = true; errore = avviso = null; conflitto = null;
        try
        {
            // Come in CollectionEdit.Salva: su un elemento esistente, svuotare il nome lo rende
            // diverso da quello salvato, quindi il pulsante Salva si accende. Senza questo
            // controllo il vincolo check (length(btrim(name)) between 1 and 200) respingerebbe la
            // scrittura e l'utente leggerebbe un messaggio di Postgres invece di una frase.
            if (string.IsNullOrWhiteSpace(nome))
            {
                errore = "Il nome dell'elemento non può essere vuoto.";
                return;
            }

            if (Nuovo)
            {
                await Crea();
                return;
            }

            await SalvaCon(elemento!.Version);
        }
        catch (Exception ex)
        {
            // v. il commento nel catch di OnParametersSetAsync: il JSON in console, la frase
            // all'utente. Qui in più conta dire che il lavoro non è perso, perché è la prima
            // domanda di chi ha appena visto fallire un salvataggio — e per la stessa ragione
            // l'azione suggerita è riprovare, mai ricaricare: una ricarica butterebbe via
            // esattamente ciò che non è stato scritto.
            Console.Error.WriteLine($"[Elemento] Salvataggio non riuscito: {ex.Message}");
            errore = "Non è stato possibile salvare: il database ha rifiutato la scrittura, oppure non è stato raggiunto. Quello che hai scritto è ancora qui: riprova fra un momento, e non chiudere la pagina.";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Crea()
    {
        if (!Guid.TryParse(await AuthState.GetUserIdAsync(), out var autore))
        {
            errore = "La sessione non è più valida: esci e rientra.";
            return;
        }

        var creato = await Repository.CreaAsync(Id, collezione!.SpaceId, autore, nome, immagine, CostruisciDati());

        // replace: true per lo stesso motivo spiegato nel commento gemello di Crea() in
        // Pages/NoteEdit.razor: .../items/new non è un posto in cui tornare col tasto Indietro —
        // l'elemento ormai esiste, e ripresentare la schermata vuota ne farebbe creare uno secondo.
        // Il cambio di rotta rilancia OnParametersSetAsync su questa stessa istanza, che rilegge
        // l'elemento: solo da quel momento c'è una versione con cui fare concorrenza ottimistica.
        // Esci e non NavigateTo: qui la guardia va disarmata, il salvataggio è riuscito (v. PaginaEditor.Esci).
        Esci($"collections/{Id}/items/{creato.Id}", replace: true);
    }

    private async Task SalvaCon(int versione)
    {
        var esito = await Repository.SalvaAsync(ItemId!.Value, versione, nome, immagine, CostruisciDati());

        switch (esito.Esito)
        {
            case EsitoSalvataggio.Salvata:
                elemento = esito.Aggiornata;
                nome = elemento!.Name;
                immagine = elemento.ImageUrl ?? "";
                CaricaValori(elemento);
                avviso = "Salvato.";
                break;

            case EsitoSalvataggio.Conflitto:
                conflitto = esito.Aggiornata;
                break;

            case EsitoSalvataggio.Rifiutata:
                // Con PuoIntervenire attivo, arrivare qui vuol dire che quel pre-controllo si è
                // rivelato sbagliato o stantio — per esempio la proprietà dello spazio è cambiata
                // mentre la pagina era aperta. È l'unico punto in cui non si può affermare la
                // regola con sicurezza, quindi non la si riscrive qui: si dice il fatto, si
                // suggerisce la causa senza giurarci, e si indica l'azione.
                errore = "Non hai più il permesso di modificare questo elemento: può essere cambiato qualcosa nello spazio. Ricarica la pagina.";
                break;

            case EsitoSalvataggio.Sparita:
                sparito = true;
                break;
        }
    }

    private void Ricarica()
    {
        if (conflitto is null) return;

        elemento = conflitto;
        nome = conflitto.Name;
        immagine = conflitto.ImageUrl ?? "";
        CaricaValori(conflitto);
        conflitto = null;
        avviso = "Caricata la versione più recente.";
    }

    private async Task Sovrascrivi()
    {
        if (conflitto is null) return;

        occupato = true; errore = null;
        try
        {
            // Si risalva con la versione DEL SERVER, non con quella che si aveva in mano: è
            // esattamente ciò che "sovrascrivi" vuol dire — prendere atto che l'altro ha scritto
            // e scriverci sopra lo stesso. Se nel frattempo arriva un terzo salvataggio questo
            // fallisce di nuovo con Conflitto, ed è il comportamento giusto.
            var versione = conflitto.Version;
            conflitto = null;
            await SalvaCon(versione);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Elemento] Sovrascrittura non riuscita: {ex.Message}");
            errore = "Non è stato possibile sovrascrivere: il database ha rifiutato la scrittura, oppure non è stato raggiunto. Quello che hai scritto è ancora qui: riprova fra un momento, e non chiudere la pagina.";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Elimina()
    {
        occupato = true; errore = null;
        try
        {
            if (await Repository.EliminaAsync(ItemId!.Value))
            {
                // Esci e non NavigateTo: qui la guardia va disarmata, l'eliminazione è riuscita (v. PaginaEditor.Esci).
                Esci($"collections/{Id}");
                return;
            }
            // Rifiuto, non guasto: EliminaAsync ha reso false. Le parole della regola vengono da
            // Services/Permessi.cs, la formulazione canonica, e non da una riformulazione: quella
            // stessa frase compare su questa pagina quando !PuoIntervenire, e due modi di dire la
            // stessa regola a due centimetri di distanza sembrano due regole. Non si riusa
            // Spiegazione() testualmente perché apre affermando che l'elemento è di qualcun altro,
            // e qui è una delle due ipotesi, non un fatto.
            errore = "Non è stato possibile eliminare l'elemento: può cancellarlo solo chi l'ha aggiunto, o chi possiede lo spazio. Può anche darsi che qualcun altro l'abbia già eliminato: ricarica la pagina per vedere com'è adesso.";
        }
        catch (Exception ex)
        {
            // Nessuna promessa "l'elemento è ancora al suo posto", a differenza della frase gemella
            // di Pages/CollectionEdit.razor: CollectionItemRepository.EliminaAsync fa TRE chiamate
            // di rete — lettura preventiva, DELETE, rilettura di conferma — quindi un'eccezione può
            // scoppiare DOPO una cancellazione riuscita, e la promessa sarebbe falsa in un caso
            // raggiungibile.
            Console.Error.WriteLine($"[Elemento] Eliminazione non riuscita: {ex.Message}");
            errore = "Non è stato possibile eliminare: il database ha rifiutato la cancellazione, oppure non è stato raggiunto. Ricarica la pagina per vedere se l'elemento c'è ancora.";
        }
        finally
        {
            occupato = false;
        }
    }
}
