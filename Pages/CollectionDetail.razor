@page "/collections/{Id:guid}"
@using Eton.Models
@using Eton.Services
@inject CollectionRepository Repository
@inject CollectionItemRepository Elementi
@inject ReviewRepository Recensioni
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>@(collezione?.Name ?? "Collezione") — Eton</PageTitle>

@if (!caricato)
{
    <Scheletro Righe="4" />
}
else if (sparita)
{
    <div class="vuoto">
        <p>Questa collezione non esiste più, o non fai più parte dello spazio che la conteneva.</p>
        <a class="btn" href="collections">Torna alle collezioni</a>
    </div>
}
else if (collezione is null)
{
    @* Ramo distinto da 'sparita', e non lo stesso flag: qui il primo caricamento è fallito, quindi
       NON sappiamo se la collezione esista. Dire "non esiste più" per una rete caduta sarebbe
       un'affermazione falsa su un fatto che non conosciamo, e lascerebbe l'utente col solo
       "Torna alle collezioni" invece che con un pulsante che ritenta. Stessa forma di
       Home.razor:16-22. *@
    <div class="vuoto">
        <div class="errore" role="alert">@errore</div>
        <button class="btn" @onclick="Riprova">Riprova</button>
    </div>
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }

    <div class="intestazione">
        <span class="icona-collezione">@(string.IsNullOrWhiteSpace(collezione!.Icon) ? "📋" : collezione.Icon)</span>
        <h1>@collezione.Name</h1>
    </div>

    <div class="azioni">
        <a class="btn" href="collections/@Id/edit">Modifica collezione</a>
        <a class="btn primario" href="collections/@Id/items/new">Nuovo elemento</a>
    </div>

    @if (elementi.Count == 0)
    {
        @* Niente pulsante qui dentro: "Nuovo elemento" è già nella barra .azioni sopra, sempre
           visibile anche a registro vuoto. Duplicarlo qui darebbe due pulsanti uguali sullo stesso
           schermo, e chi guarda si chiederebbe se fanno cose diverse. *@
        <div class="vuoto">
            <span class="icona-vuoto"><Icona Nome="collezioni" /></span>
            <p>Ancora nessun elemento in questa collezione.</p>
            <p class="spiega">Un elemento è una cosa da giudicare: una birra, un film, un posto. Lo compili con i campi della collezione, e poi ognuno gli lascia il suo voto.</p>
        </div>
    }
    else
    {
        @* votiMancanti dice al markup che i voti non si sono potuti leggere: senza questo, ogni riga
           mostrerebbe "—" come se nessuno avesse ancora votato, che è un'affermazione falsa su un
           fatto che non conosciamo — stessa distinzione di dettagliMancanti in Home.razor:71-73. *@
        @* I comandi che dipendono dai voti spariscono, non si limitano a convivere con l'avviso:
           «Voto più alto» ordinerebbe tutti gli elementi a pari merito e sembrerebbe aver ordinato,
           e «Da provare» filtrerebbe su un HaiRecensito sempre falso, cioè non nasconderebbe niente
           pur risultando acceso. Un comando che risponde senza fare quello che promette è peggio di
           un comando assente. È la forma dei rami di Home.razor:74-92 e Notes.razor:46-58, dove il
           flag SOSTITUISCE la sezione che dipende dal dato mancante invece di aggiungersi sopra. *@
        @if (votiMancanti)
        {
            <p class="testo-tenue">Non sono riuscito a leggere i voti di questa collezione: le medie e il filtro «Da provare» non sono disponibili.</p>
        }
        else
        {
            <div class="barra-elenco">
                <label class="selettore">
                    <span class="etichetta-piccola">Ordina per</span>
                    <select value="@ordine" @onchange="CambiaOrdine">
                        <option value="@Ordine.Nome">Nome</option>
                        @if (OrdinePerVotoPossibile)
                        {
                            <option value="@Ordine.Media">Voto più alto</option>
                        }
                    </select>
                </label>
                <button class="pastiglia @(soloDaProvare ? "accesa" : "")" @onclick="() => soloDaProvare = !soloDaProvare">
                    Da provare
                </button>
            </div>
        }

        @* Materializzato una volta sola: 'Mostrati' filtra e ordina a ogni accesso, e qui servirebbe
           tre volte — il ramo vuoto, il conteggio della testata, il ciclo delle righe. La
           dichiarazione va nuda, senza @@{ }: dentro un blocco Razor una riga che comincia con codice
           C# è già codice, come 'var riepilogo' poco più sotto e 'var altre' in
           Shared/RecensioniElemento.razor. *@
        var mostrati = Mostrati.ToList();

        @* Resta nudo apposta, senza icona né riga che insegna: non è un registro vuoto, è il
           risultato di un filtro "Da provare" su una collezione che elementi ne ha eccome. Spiegare
           cos'è un elemento a chi li ha provati tutti è l'aiuto che offende. *@
        @if (mostrati.Count == 0)
        {
            <div class="vuoto">
                <p>Hai già provato tutto quello che c'è qui.</p>
            </div>
        }
        else
        {
            <div class="testa-registro">
                <span>@Testi.Conteggio(mostrati.Count, "elemento", "elementi")</span>
                @if (!votiMancanti)
                {
                    <span class="colonna">Media</span>
                }
            </div>

            <ul class="elenco-elementi">
                @foreach (var e in mostrati)
                {
                    var riepilogo = Riepilogo(e);
                    <li>
                        <a class="riga-elemento" href="collections/@Id/items/@e.Id">
                            @if (Miniatura(e) is string src)
                            {
                                <img class="miniatura" src="@src" alt="" loading="lazy" />
                            }
                            <span class="testi">
                                <span class="nome">@e.Name</span>
                                <span class="meta">
                                    @riepilogo
                                    @if (!votiMancanti && Coperto(e))
                                    {
                                        @if (riepilogo.Length > 0)
                                        {
                                            <text> · </text>
                                        }
                                        <span class="dato">@TestoCoperto(e)</span>
                                    }
                                </span>
                            </span>
                            @* Omessa del tutto quando i voti non si sono letti: "—" significa
                               "nessuno ha votato", che qui non sappiamo. *@
                            @if (!votiMancanti)
                            {
                                @if (Coperto(e))
                                {
                                    <span class="voto-riga coperto">?</span>
                                }
                                else
                                {
                                    <span class="voto-riga">@CalcoliVoti.Testo(Voti(e.Id).Media)</span>
                                }
                            }
                        </a>
                    </li>
                }
            </ul>
        }
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Collection? collezione;
    private IReadOnlyList<CollectionItem> elementi = [];
    private IReadOnlyList<CampoDefinizione> campi = [];
    private bool caricato, sparita;
    private string? errore;
    private int generazione;

    private IReadOnlyDictionary<Guid, RiepilogoVoti> voti =
        new Dictionary<Guid, RiepilogoVoti>();

    // Solo per le collezioni alla cieca: quante persone hanno recensito ciascun elemento, letto da
    // ConteggiPerSpazioAsync perché su un elemento che io non ho ancora recensito le righe vere
    // non arrivano affatto (RLS). Su una collezione normale resta vuoto e non si legge mai.
    // Recensioni, non voti: comprende chi ha lasciato solo un commento (v. CalcoliVoti.TestoRecensioni).
    private IReadOnlyDictionary<Guid, int> conteggiRecensori = new Dictionary<Guid, int>();

    // Il conteggio dei recensori non si è potuto leggere. Distinto da votiMancanti perché è molto meno
    // grave — le medie ci sono e la pagina funziona — ma non si può ignorare: senza, un elemento
    // coperto ricadrebbe sul ramo della media e mostrerebbe "—", cioè "nessuno ha votato", che è
    // esattamente la bugia che il conteggio esiste per evitare.
    private bool conteggiMancanti;

    private Guid? io;
    private bool soloDaProvare;
    private bool votiMancanti;
    private Ordine ordine = Ordine.Nome;
    private enum Ordine { Nome, Media }

    // Su una collezione cieca la media della maggior parte degli elementi non è conoscibile: le
    // righe altrui non arrivano finché non hai votato tu. «Voto più alto» ordinerebbe quindi per un
    // valore che per quasi tutti vale null, mettendo in fondo — insieme a quelli che nessuno ha
    // giudicato — anche gli elementi con tre voti alti che semplicemente non puoi ancora vedere.
    // L'opzione sparisce, come già spariscono i comandi quando i voti non si sono letti: un comando
    // che risponde senza fare quello che promette è peggio di un comando assente.
    private bool OrdinePerVotoPossibile => collezione is not null && !collezione.Blind;

    // Come in NoteEdit: Id cambia navigando fra collezioni senza smontare il componente, quindi il
    // ricaricamento va agganciato a OnParametersSetAsync e non a OnInitializedAsync, e due
    // caricamenti possono sovrapporsi con quello partito prima che risponde per ultimo.
    protected override Task OnParametersSetAsync() => Carica();

    // Estratto da OnParametersSetAsync per poterlo richiamare da Riprova: un primo caricamento
    // fallito deve poter essere ritentato senza costringere l'utente a ricaricare la pagina.
    private async Task Carica()
    {
        var mia = ++generazione;

        caricato = false;
        errore = null;
        sparita = false;

        try
        {
            var letta = await Repository.LeggiAsync(Id);
            if (mia != generazione) return;

            collezione = letta;
            if (collezione is null)
            {
                sparita = true;
                caricato = true;
                return;
            }

            campi = SchemaCampi.Ordina(collezione.Fields);

            var elencati = await Elementi.ElencaAsync(Id);
            if (mia != generazione) return;

            elementi = elencati;
        }
        catch (Exception ex)
        {
            if (mia != generazione) return;
            errore = $"Non è stato possibile aprire la collezione: {ex.Message}";

            // NON si accende 'sparita': quello significa "il database ha risposto che non c'è", e
            // qui il database non ha risposto affatto. Si azzera invece tutto ciò che era a schermo,
            // come fa NoteEdit.razor:161: se il caricamento fallito è quello della collezione B
            // raggiunta da /collections/A, tenere i dati precedenti mostrerebbe il nome e gli
            // elementi di A sotto l'indirizzo di B, con i link delle righe che puntano a elementi
            // di un'altra collezione. Meglio nessun dato che dati attribuiti alla cosa sbagliata.
            collezione = null;
            elementi = [];
            campi = [];
        }

        // Try separato, non "in sequenza nello stesso try": i voti sono un dettaglio accessorio
        // rispetto all'elenco degli elementi appena caricato sopra, e un loro fallimento non deve
        // far sparire un elenco caricato benissimo — stessa scelta di CaricaDettagli in
        // Home.razor:184-188. 'votiMancanti' (non un dizionario vuoto lasciato lì) dice al markup
        // che le medie non si sono potute leggere, invece di lasciarlo affermare "nessun voto" su
        // un fatto che in realtà non conosciamo: è lo stesso errore già corretto in Home.razor:71-73
        // e nei rami di Notes.razor.
        voti = new Dictionary<Guid, RiepilogoVoti>();
        conteggiRecensori = new Dictionary<Guid, int>();
        votiMancanti = false;
        conteggiMancanti = false;
        io = null;

        if (collezione is not null)
        {
            try
            {
                if (Guid.TryParse(await AuthState.GetUserIdAsync(), out var utente))
                    io = utente;

                var recensioni = await Recensioni.ElencaPerSpazioAsync(collezione.SpaceId);
                if (mia != generazione) return;

                voti = CalcoliVoti.Riepiloghi(recensioni, io);

                // Solo alla cieca: su una collezione normale il conteggio si legge già dalle righe
                // appena scaricate (Voti sopra), e questa sarebbe una richiesta di rete in più per
                // un numero che si ha già.
                if (collezione.Blind)
                {
                    // Try annidato, non nello stesso try esterno: un fallimento qui riguarda solo il
                    // conteggio delle recensioni coperte, non le medie appena lette sopra. Nello stesso
                    // try l'eccezione salirebbe al catch esterno e accenderebbe votiMancanti, facendo
                    // sparire medie lette benissimo per colpa di una seconda chiamata accessoria.
                    try
                    {
                        var conteggi = await Recensioni.ConteggiPerSpazioAsync(collezione.SpaceId);
                        if (mia != generazione) return;

                        conteggiRecensori = conteggi;
                    }
                    catch (Exception ex)
                    {
                        if (mia != generazione) return;

                        // Nessun votiMancanti: le medie restano valide e il resto della pagina
                        // funziona. Serve però un flag suo, perché senza il markup ricadrebbe sul
                        // ramo della media e scriverebbe "—" su un elemento coperto — cioè "nessuno
                        // ha votato" proprio nel caso in cui i voti esistono e non si sono potuti
                        // contare. È lo scenario più concreto che ci sia: se la migrazione del voto
                        // al buio non è ancora stata applicata al database, la funzione review_counts
                        // non esiste e ogni chiamata finisce qui.
                        conteggiMancanti = true;
                        Console.Error.WriteLine($"[Collezione] Conteggi voti al buio non disponibili: {ex.Message}");
                    }
                }
            }
            catch (Exception ex)
            {
                if (mia != generazione) return;
                votiMancanti = true;

                // Il dettaglio non finisce a schermo — il markup dice già all'utente cosa manca, e
                // un messaggio di rete non lo aiuterebbe — ma non va nemmeno buttato via: senza una
                // traccia, un fallimento sistematico dei voti resterebbe indistinguibile da uno
                // spazio in cui nessuno ha ancora votato. Stesso formato di Notes.razor:187-194 e
                // SpaceDetail.
                Console.Error.WriteLine($"[Collezione] Voti non disponibili: {ex.Message}");
            }
        }

        caricato = true;
    }

    private Task Riprova() => Carica();

    private void CambiaOrdine(ChangeEventArgs e)
    {
        if (Enum.TryParse<Ordine>(e.Value?.ToString(), out var scelto))
            ordine = scelto;
    }

    // Non filtra e riordina 'elementi' sul posto: 'elementi' resta l'elenco vero, così soloDaProvare
    // e ordine si possono cambiare avanti e indietro senza dover ricaricare nulla dal server.
    private IEnumerable<CollectionItem> Mostrati
    {
        get
        {
            var elenco = soloDaProvare
                ? elementi.Where(e => !Voti(e.Id).HaiRecensito)
                : elementi;

            // Media ?? decimal.MinValue: gli elementi senza voti finiscono in fondo invece che in
            // cima. OrderByDescending su un decimal? metterebbe i null in testa, cioè presenterebbe
            // come "voto più alto" proprio quelli che nessuno ha giudicato.
            // ThenBy sul nome: senza, due elementi con la stessa media si ordinano in modo stabile
            // ma apparentemente casuale, e l'elenco sembra cambiare senza motivo fra un
            // caricamento e l'altro.
            // StringComparer.Ordinal: sotto InvariantGlobalization=true non esistono confronti
            // culture-aware; l'ordinamento alfabetico è comunque quello che fa già il database su
            // 'name'.
            // Il ramo Ordine.Nome non riordina niente: gli elementi arrivano già ordinati per nome
            // dal database (indice collection_items (collection_id, name)), quindi riordinarli
            // sarebbe lavoro sprecato che produce lo stesso risultato.
            // La seconda condizione non è ridondante col markup che nasconde l'opzione: 'ordine' è
            // stato del componente e sopravvive alla navigazione fra collezioni (Id cambia senza
            // smontare nulla, v. OnParametersSetAsync). Chi ha scelto «Voto più alto» su una
            // collezione normale e passa a una cieca porterebbe con sé un ordinamento che lì non ha
            // più significato, e non avrebbe nemmeno il comando per toglierlo.
            return ordine == Ordine.Media && OrdinePerVotoPossibile
                ? elenco.OrderByDescending(e => Voti(e.Id).Media ?? decimal.MinValue)
                        .ThenBy(e => e.Name, StringComparer.Ordinal)
                : elenco;
        }
    }

    private RiepilogoVoti Voti(Guid elementoId) =>
        voti.TryGetValue(elementoId, out var r) ? r : new RiepilogoVoti(null, 0, null, false);

    private int Recensori(Guid elementoId) =>
        conteggiRecensori.TryGetValue(elementoId, out var n) ? n : 0;

    // Vero quando un elemento alla cieca è coperto per me: non l'ho ancora recensito, e o so già che
    // qualcun altro l'ha fatto (Recensori(e.Id) > 0, letto da ConteggiPerSpazioAsync perché su un
    // elemento non mio le righe vere non arrivano affatto per via delle RLS), oppure non lo so perché
    // proprio quel conteggio non si è potuto leggere (conteggiMancanti): in quest'ultimo caso si
    // presume coperto, perché è l'ipotesi che non rischia di mostrare come "nessuno ha votato" un
    // elemento che invece ha già recensioni.
    //
    // In colonna va solo un "?" e non più il conteggio di chi ha già recensito: la colonna dei voti
    // è larga esattamente 3.5rem, e una pastiglia con dentro "coperto" o "3 recensioni" è larga il
    // doppio e sfonda l'incolonnamento di tutte le righe. Il "?" è lo stesso segno che si trova
    // aprendo l'elemento (RecensioniElemento.razor, .voto-coperto).
    private bool Coperto(CollectionItem e) =>
        collezione is not null && collezione.Blind && !Voti(e.Id).HaiRecensito
        && (Recensori(e.Id) > 0 || conteggiMancanti);

    // Quante recensioni ci sono già su un elemento che non hai ancora aperto, e il fatto che siano
    // coperte. Sta nella riga di meta e non nella colonna dei voti: lì dentro ci va solo qualcosa di
    // largo 3.5rem (v. Coperto).
    private string TestoCoperto(CollectionItem e) =>
        conteggiMancanti ? "coperte" : $"{CalcoliVoti.TestoRecensioni(Recensori(e.Id))}, coperte";

    // L'URL lo scrive un altro membro dello spazio: uno schema come data: o javascript: dentro un
    // src non è un semplice link rotto, va bonificato come in MarkdownRenderer.
    private static string? Miniatura(CollectionItem e)
        => e.ImageUrl is { Length: > 0 } url && MarkdownRenderer.UrlAmmessa(url) ? url : null;

    // I valori dei primi due campi non vuoti, resi con Testo perché qui è testo da leggere, non da
    // rimettere in un input.
    private string Riepilogo(CollectionItem e)
    {
        var pezzi = new List<string>();

        foreach (var campo in campi)
        {
            if (pezzi.Count >= 2) break;

            // '?.' su Data: il vincolo collection_items_data_shape rifiuta un data che non sia un
            // oggetto, quindi Newtonsoft non dovrebbe mai sovrascrivere l'inizializzatore con null —
            // ma qui siamo dentro il @foreach dell'elenco, e una NullReferenceException romperebbe
            // la pagina di chiunque stia in quello spazio, non solo la riga malformata. È lo stesso
            // ragionamento del try/catch di ValoriElemento.Testo.
            var testo = ValoriElemento.Testo(e.Data?.GetValueOrDefault(campo.Key), campo.Type);
            if (testo.Length > 0) pezzi.Add(testo);
        }

        return string.Join(" · ", pezzi);
    }
}
