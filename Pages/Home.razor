@page "/"
@using Eton.Models
@inject AuthStateService AuthState
@inject SpaceStateService Spazi
@inject SpaceRepository Repository
@inject NoteRepository NoteRepository
@inject CollectionRepository CollectionRepository
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Eton</PageTitle>

@if (!caricato)
{
    <p class="avvio">Caricamento…</p>
}
else if (Spazi.Attivo is null && errore is not null)
{
    <div class="vuoto">
        <div class="errore" role="alert">@errore</div>
        <button class="btn" @onclick="Riprova">Riprova</button>
    </div>
}
else if (Spazi.Attivo is null)
{
    <div class="vuoto">
        <p>Non sei ancora dentro nessuno spazio.</p>
        <a class="btn primary" href="spaces">Vai agli spazi</a>
    </div>
}
else
{
    @* Se lo spazio c'è, l'errore è di un caricamento secondario (i dettagli dello spazio): va
       segnalato SOPRA il contenuto, non al posto suo. Prendersi tutta la pagina per un dettaglio
       mancante nasconderebbe uno spazio caricato benissimo. Stessa forma di SpaceDetail. *@
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }

    @* Su schermo largo il selettore sta in fondo alla barra di navigazione, che è sempre a
       schermo: qui sparisce (v. .solo-stretto in app.css), altrimenti la stessa tendina
       comparirebbe due volte nella stessa schermata e nessuna delle due sembrerebbe quella
       buona. Sul telefono la barra in basso non ha spazio per contenerlo, quindi resta qui. *@
    <header class="intestazione solo-stretto">
        <SelettoreSpazio />
    </header>

    <h1>@Spazi.Attivo.Name</h1>
    <p class="sottotitolo">
        @if (Spazi.Attivo.IsPersonal)
        {
            <text>Il tuo spazio personale: quello che ci metti lo vedi solo tu.</text>
        }
        else if (dettagliMancanti)
        {
            <text>Membri non disponibili.</text>
        }
        else
        {
            <text>@membri membri.</text>
        }
    </p>

    @* Le due schede sono riquadri indipendenti: sul telefono si impilano, su schermo largo stanno
       affiancate (v. .griglia-due in app.css). Senza questo contenitore non ci sarebbe niente su
       cui appoggiare la griglia, e su un monitor le due schede resterebbero una sotto l'altra in
       una colonna stretta con metà schermo vuoto accanto. *@
    <div class="griglia-due">
        <div class="scheda">
            <h2>Note</h2>
            @* L'ordine dei rami conta: 'dettagliMancanti' va provato PRIMA di 'note.Count == 0', perché
               l'elenco è vuoto in entrambi i casi e solo il flag distingue "non ci sono note" da "non
               sono riuscito a leggerle". *@
            @if (dettagliMancanti)
            {
                <p class="testo-tenue">Non sono riuscito a leggere le note di questo spazio.</p>
            }
            else if (note.Count == 0)
            {
                <p class="testo-tenue">Ancora nessuna nota in questo spazio.</p>
            }
            else
            {
                <ul class="elenco-note compatto">
                    @foreach (var n in note)
                    {
                        <li>
                            <a href="notes/@n.Id">@n.TitoloVisibile()</a>
                        </li>
                    }
                </ul>
            }
            <div class="azioni">
                <a class="btn" href="notes">Tutte le note</a>
                <a class="btn primary" href="notes/new">Nuova nota</a>
            </div>
        </div>

        <div class="scheda">
            <h2>Collezioni</h2>
            @* L'ordine dei rami conta: 'dettagliMancanti' va provato PRIMA di 'collezioni.Count == 0',
               perché l'elenco è vuoto in entrambi i casi e solo il flag distingue "non ci sono
               collezioni" da "non sono riuscito a leggerle". *@
            @if (dettagliMancanti)
            {
                <p class="testo-tenue">Non sono riuscito a leggere le collezioni di questo spazio.</p>
            }
            else if (collezioni.Count == 0)
            {
                <p class="testo-tenue">Ancora nessuna collezione in questo spazio.</p>
            }
            else
            {
                <ul class="elenco-collezioni compatto">
                    @foreach (var c in collezioni)
                    {
                        <li>
                            <a href="collections/@c.Id">@(string.IsNullOrWhiteSpace(c.Icon) ? "" : c.Icon + " ")@c.Name</a>
                        </li>
                    }
                </ul>
            }
            <div class="azioni">
                <a class="btn" href="collections">Tutte le collezioni</a>
                <a class="btn primary" href="collections/new">Nuova collezione</a>
            </div>
        </div>
    </div>

    <div class="azioni">
        <a class="btn" href="spaces/@Spazi.Attivo.Id">Gestisci questo spazio</a>
    </div>
}

@code {
    private bool caricato;
    private int membri;
    private IReadOnlyList<Note> note = [];
    private IReadOnlyList<Collection> collezioni = [];
    private string? errore;
    private int generazione;

    // Vero quando i dettagli non si sono potuti leggere. Serve al markup per non affermare cose
    // che non sa: azzerare membri/note prima di leggere evita di mostrare quelli dello spazio
    // precedente, ma "0 membri" e "Ancora nessuna nota" sono affermazioni precise su uno spazio di
    // cui non abbiamo letto niente. Accanto a un banner d'errore si contraddicono a vicenda.
    private bool dettagliMancanti;

    // Lo spazio di cui i dettagli a schermo sono stati letti. Serve a distinguere un evento che
    // annuncia un cambio vero da uno che ripete quello che già si sta mostrando.
    private Guid? spazioMostrato;

    // Vero mentre è il primo caricamento a essere in corso. Quel caricamento emette esso stesso
    // l'evento Cambiato, e i dettagli li legge già Carica() subito dopo: senza questa guardia
    // partirebbero due letture identiche, e la più lenta finirebbe scartata dal contatore di
    // generazione dopo aver comunque occupato la rete.
    private bool caricamentoIniziale;

    protected override async Task OnInitializedAsync()
    {
        Spazi.Cambiato += SpazioCambiato;
        await Carica();
    }

    private async Task Carica()
    {
        errore = null;
        try
        {
            caricamentoIniziale = true;
            await Spazi.AssicuraCaricatoAsync();
        }
        catch (Exception ex)
        {
            // Senza questo, un errore di rete al primo caricamento risalirebbe fino al riquadro
            // di crash di Blazor: schermata bianca e "Ricarica", invece di un messaggio e un
            // pulsante che ritenta senza buttare via l'applicazione.
            errore = $"Non è stato possibile caricare i tuoi spazi: {ex.Message}";
            caricato = true;
            return;
        }
        finally
        {
            // Nel finally e non dopo il try: il ramo d'errore esce con un return, e una riga
            // scritta sotto il blocco non verrebbe mai eseguita in quel caso — la guardia
            // resterebbe alzata per sempre e la Home smetterebbe di reagire ai cambi di spazio.
            caricamentoIniziale = false;
        }

        // I dettagli si gestiscono l'errore da soli, dentro CaricaDettagli: sono accessori, e un
        // loro fallimento non deve far sparire uno spazio che si è caricato benissimo.
        await CaricaDettagli("Spazio caricato");

        caricato = true;
    }

    private async Task Riprova()
    {
        caricato = false;
        await Carica();
    }

    // Membri e note insieme: sono entrambi dettagli dello spazio attivo, entrambi accessori
    // rispetto al fatto che lo spazio si sia caricato. Il metodo gestisce anche il proprio errore,
    // perché solo qui si sa se la risposta arrivata è ancora quella buona: un fallimento già
    // sorpassato da una lettura più recente non deve piantare un banner rosso sopra dati giusti.
    private async Task CaricaDettagli(string premessa)
    {
        // Contatore di generazione, come in NoteEdit.razor:119 e in SpaceDetail. Dal <select> si
        // può cambiare spazio due volte prima che la prima lettura torni, e su rete mobile la
        // seconda risposta può benissimo arrivare per prima: senza guardia la continuazione più
        // lenta scrive per ultima e lascia il nome di uno spazio accanto ai dettagli di un altro.
        // Nessun errore comparirebbe, perché entrambe le letture sono riuscite.
        var mia = ++generazione;

        // Azzerati PRIMA di leggere, e non dopo. Se la lettura fallisce, mostrare le note dello
        // spazio precedente sotto il nome di quello nuovo sarebbe peggio che non mostrarne nessuna:
        // sembrerebbero note di questo spazio, e non c'è niente a schermo che smentisca.
        membri = 0;
        note = [];
        collezioni = [];
        dettagliMancanti = false;

        // Segnato PRIMA degli await, non dopo: mentre la lettura è in volo possono arrivare altri
        // eventi per lo stesso spazio — il selettore della barra ne emette uno a ogni ridisegno
        // dell'elenco — e senza questa riga ciascuno di essi farebbe ripartire la stessa lettura
        // da capo.
        spazioMostrato = Spazi.Attivo?.Id;

        if (Spazi.Attivo is null) return;

        // L'id si cattura UNA volta sola. Rileggere Spazi.Attivo dopo un await interrogherebbe lo
        // spazio nel frattempo diventato attivo invece di quello per cui la lettura è partita, e
        // dopo un logout — Dimentica() azzera Attivo — sarebbe direttamente un riferimento nullo.
        var spazio = Spazi.Attivo;

        try
        {
            var quantiMembri = spazio.IsPersonal ? 0 : (await Repository.MembriAsync(spazio.Id)).Count;
            if (mia != generazione) return;

            // Solo le tre più recenti: la Home è un riepilogo, l'elenco completo sta in /notes.
            // Il limite arriva fino alla query, così non si scaricano mille note per mostrarne tre.
            var ultime = await NoteRepository.ElencaAsync(spazio.Id, 3);
            if (mia != generazione) return;

            var ultimeCollezioni = await CollectionRepository.ElencaAsync(spazio.Id, 3);
            if (mia != generazione) return;

            // Scritte insieme e solo alla fine: assegnarle man mano lascerebbe a schermo, per tutta
            // la durata della seconda lettura, il conteggio nuovo accanto alle note vecchie.
            membri = quantiMembri;
            note = ultime;
            collezioni = ultimeCollezioni;
        }
        catch (Exception ex)
        {
            if (mia != generazione) return;
            errore = $"{premessa}, ma non ho potuto leggerne i dettagli: {ex.Message}";
            dettagliMancanti = true;
        }
    }

    // Lo spazio attivo si cambia dal selettore, che ora sta in due posti: in cima a questa pagina
    // sul telefono, e in fondo alla barra di navigazione su schermo largo (v. Shared/SelettoreSpazio.razor).
    // La Home non può più sapere chi l'ha cambiato, quindi non reagisce più al gesto ma
    // all'evento — che è anche più corretto di prima: prima un cambio di spazio avvenuto altrove
    // avrebbe lasciato a schermo le note dello spazio precedente sotto il nome di quello nuovo.
    private void SpazioCambiato()
    {
        if (caricamentoIniziale) return;

        // Stesso spazio: l'evento annuncia un ridisegno dell'elenco, non un cambio di contesto.
        // Rileggere note, collezioni e membri sarebbe traffico per riscrivere quello che c'è già.
        if (Spazi.Attivo?.Id == spazioMostrato)
        {
            InvokeAsync(StateHasChanged);
            return;
        }

        // L'evento arriva da un servizio, cioè fuori dal ciclo di rendering di questo componente:
        // senza InvokeAsync il lavoro partirebbe sul thread sbagliato. CaricaDettagli non lancia —
        // si gestisce l'errore da sé — quindi questa continuazione non ha nulla da far risalire.
        InvokeAsync(async () =>
        {
            errore = null;
            await CaricaDettagli("Spazio cambiato");
            StateHasChanged();
        });
    }

    public void Dispose() => Spazi.Cambiato -= SpazioCambiato;
}
