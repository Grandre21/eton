@page "/collections"
@using Eton.Models
@inherits PaginaRegistro
@inject CollectionRepository Repository

<PageTitle>Collezioni — Eton</PageTitle>

<TestataPagina Titolo="Collezioni">
    <Azione>
        @* Senza uno spazio attivo "Nuova collezione" porterebbe a un modulo che non ha dove salvare,
           e la pagina mostra già il proprio invito ad andare negli spazi. *@
        @if (Spazi.Attivo is not null)
        {
            <a class="btn primario compatto" href="collections/new">Nuova collezione</a>
        }
    </Azione>
    <Aiuto>
        <p>I campi di una collezione li decide chi la crea, e valgono per tutti i suoi elementi. Ogni membro dello spazio lascia il proprio voto.</p>
        <p>Con il voto al buio, chi apre un elemento non vede i voti degli altri finché non mette il suo: vede solo quante persone hanno recensito.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <Scheletro Righe="4" />
}
else if (Spazi.Attivo is null && errore is not null)
{
    <ErroreRiprova Messaggio="@errore" OnRiprova="Riprova" />
}
else if (Spazi.Attivo is null)
{
    <div class="vuoto">
        <p>Serve uno spazio prima di poter creare collezioni.</p>
        <a class="btn primario" href="spaces">Vai agli spazi</a>
    </div>
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }

    <p class="sottotitolo">In <strong>@Spazi.Attivo.Name</strong></p>

    @* L'ordine conta: 'datiNonLetti' va provato PRIMA di 'collezioni.Count == 0', perché
       l'elenco è vuoto in entrambi i casi e solo il flag distingue "non ci sono collezioni" da
       "non ho potuto leggerle". *@
    @if (datiNonLetti)
    {
        <div class="vuoto">
            <p>Non sono riuscito a leggere le collezioni di questo spazio.</p>
            <button class="btn" @onclick="Riprova">Riprova</button>
        </div>
    }
    else if (collezioni.Count == 0)
    {
        @* Il pulsante sta qui dentro oltre che nella testata, e il doppione non è un rischio:
           stessa etichetta e stessa destinazione, quindi si leggono come la stessa azione in
           due posti. A registro vuoto l'occhio sta su questo blocco centrato — è lì che va
           messa l'azione — mentre quello in testata è compatto e in un angolo. Non è ridondante
           nemmeno per gli stati: a registro pieno questo blocco non esiste, e resta solo la
           testata. Qui Spazi.Attivo è non nullo per costruzione (il ramo che lo esclude è più
           sopra), quindi "collections/new" ha sempre dove salvare e non serve la guardia che
           protegge il pulsante della testata. *@
        <div class="vuoto">
            <span class="icona-vuoto"><Icona Nome="collezioni" /></span>
            <p>Ancora nessuna collezione qui.</p>
            <p class="spiega">Una collezione è un elenco che si vota insieme: birre, film, ristoranti. I campi li decidi tu, e ogni membro dello spazio lascia il suo voto.</p>
            <a class="btn primario" href="collections/new">Nuova collezione</a>
        </div>
    }
    else
    {
        <div class="testa-registro">
            <span>@Testi.Conteggio(collezioni.Count, "collezione", "collezioni")</span>
        </div>
        <ul class="registro elenco-collezioni">
            @foreach (var c in collezioni)
            {
                <li>
                    <a class="riga riga-collezione" href="collections/@c.Id">
                        <span class="icona-collezione">@(string.IsNullOrWhiteSpace(c.Icon) ? "📋" : c.Icon)</span>
                        @* Nome e meta vanno avvolti insieme, non messi come figli diretti: la riga è
                           un flex orizzontale, quindi senza questo contenitore finirebbero affiancati
                           all'icona invece che impilati, e un nome lungo spingerebbe la data fuori
                           dal riquadro invece di troncarsi. Stessa struttura di .riga-elemento. *@
                        <span class="testi">
                            <span class="nome">@c.Name</span>
                            <span class="meta">@Meta(c) · <span class="dato">@Testi.Data(c.UpdatedAt)</span></span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    private IReadOnlyList<Collection> collezioni = [];

    protected override string NomePlurale => "le collezioni";

    protected override async Task Leggi(Space attivo)
    {
        collezioni = [];

        try
        {
            collezioni = await Repository.ElencaAsync(attivo.Id);
        }
        catch (Exception ex)
        {
            SegnalaNonLetti(ex);
            return;
        }
    }

    // Separato dalla data perché nel markup quella va in un <span class="dato"> a sé, per renderla
    // in carattere monospaziato: il conteggio dei campi no, quindi non possono restare un unico
    // testo. La data la scrive Testi.Data, che è la stessa in tutte le pagine.
    //
    // Il conteggio dei campi resta qui e non passa da Testi.Conteggio: lo zero non dice "0 campi"
    // ma "nessun campo", che è una frase e non un conteggio — la stessa distinzione per cui esiste
    // CalcoliVoti.TestoVoti accanto a Testi.Conteggio.
    private string Meta(Collection c) => c.Fields.Count switch
    {
        0 => "nessun campo",
        1 => "1 campo",
        var n => $"{n} campi"
    };
}
