@page "/profile"
@inject AuthStateService AuthState

<PageTitle>Profilo — Eton</PageTitle>

@* Come nelle altre schermate, la testata sta fuori dalla catena @if: il titolo e il "?" restano
   anche durante il caricamento.

   Questa pagina mostra tre cose e basta — nome, email e "Esci" — quindi tutto il resto è
   invisibile, ed è di quello che parla l'aiuto: da dove arrivano i due dati, chi altri li vede, e
   che cosa fa davvero "Esci". Nessuno dei tre è deducibile da ciò che è a schermo. *@
<TestataPagina Titolo="Profilo">
    <Aiuto>
        <p>Nome ed email arrivano dall'account Google con cui sei entrato: Eton li legge e basta, non ha un posto dove cambiarli.</p>
        <p>Il nome e la foto compaiono agli altri membri degli spazi che condividi, nell'elenco dei membri. L'email no: non fa parte del profilo che gli altri leggono.</p>
        <p>«Esci» chiude la sessione solo su questo dispositivo: se sei entrato anche dal telefono, lì resti dentro. E non cancella niente — spazi, note, collezioni e spese restano dove sono.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <p class="avvio">Caricamento…</p>
}
else
{
    <div class="scheda">
        <p class="nome-grande">@(nome ?? "utente")</p>
        @if (!string.IsNullOrEmpty(email))
        {
            <p class="testo-tenue">@email</p>
        }
    </div>

    <div class="azioni">
        <button class="btn rosso" @onclick="Esci" disabled="@occupato">
            @(occupato ? "Esco…" : "Esci")
        </button>
    </div>
}

@code {
    private string? nome, email;
    private bool caricato;
    private bool occupato;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            nome = await AuthState.GetDisplayNameAsync();
            email = await AuthState.GetEmailAsync();
        }
        catch (Exception ex)
        {
            // Il profilo non è indispensabile: senza nome ed email il pulsante "Esci" funziona
            // comunque, ed è l'unica cosa per cui si arriva davvero su questa pagina.
            Console.Error.WriteLine($"[Profilo] Lettura dell'identità fallita: {ex.Message}");
        }
        caricato = true;
    }

    // `occupato` non è cosmesi: LogoutAsync attende una chiamata di rete, e per tutta la sua durata
    // l'applicazione resta navigabile. Senza il pulsante disabilitato l'utente può premere due
    // volte, o andarsene altrove mentre esce.
    private async Task Esci()
    {
        occupato = true;
        await AuthState.LogoutAsync();
    }
}
