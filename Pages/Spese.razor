@page "/expenses"
@using Eton.Models
@inherits PaginaRegistro
@inject ExpenseRepository Repository
@inject SpaceRepository SpaziRepository
@inject AuthStateService AuthState

<PageTitle>Spese — Eton</PageTitle>

<TestataPagina Titolo="Spese">
    <Aiuto>
        <p>Il riepilogo conta solo il mese che stai guardando: cambiando mese cambiano il totale e le categorie.</p>
        <p>Ogni spesa resta legata a chi l'ha pagata, e questo non cambia più dopo averla segnata.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <Scheletro Righe="4" />
}
else if (Spazi.Attivo is null && errore is not null)
{
    <ErroreRiprova Messaggio="@errore" OnRiprova="Riprova" />
}
else if (Spazi.Attivo is null)
{
    <div class="vuoto">
        <p>Serve uno spazio prima di poter segnare una spesa.</p>
        <a class="btn primario" href="spaces">Vai agli spazi</a>
    </div>
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }

    <p class="sottotitolo">In <strong>@Spazi.Attivo.Name</strong></p>

    @* Due frasi e non una, perché sono due regole diverse: chi VEDE (tutti i membri) e chi TOCCA
       (chi ha pagato, o il proprietario) — confonderle è l'equivoco che questa riga serve a
       evitare. Solo negli spazi condivisi: nel personale non c'è nessun altro che potrebbe vedere
       o toccare niente, e la frase sarebbe rumore. Nella Home la stessa domanda ("chi vede le mie
       spese?") non trova risposta fuori dal caso personale — v. Home.razor:73-85 — questa riga è
       dove la risposta manca davvero, perché è dove si agisce. *@
    @if (!Spazi.Attivo.IsPersonal)
    {
        @* Impersonale per lo stesso motivo spiegato in Pages/SpesaEdit.razor:67: è una regola, non un invito. *@
        <p class="spiega">Le spese di questo spazio le vedono tutti i membri. Può modificarle e cancellarle chi le ha pagate, o chi possiede lo spazio.</p>
    }

    @* Il modulo sta in cima e sempre aperto, senza nessuna navigazione per arrivarci: il requisito
       da cui nasce questa pagina è la parola "comodamente", e un tocco in più per segnare una
       spesa è esattamente ciò che fa abbandonare l'abitudine dopo una settimana. Il markup dei
       campi ricalca Pages/SpesaEdit.razor: gli stili sono scritti contro quelle classi. *@
    <section class="modulo-spesa">
        <div class="campi-spesa">
            <label class="campo">
                <span class="etichetta-campo">Importo</span>
                <input class="importo-spesa dato" type="text" inputmode="decimal" autofocus
                       placeholder="0,00" @bind="nuovoImporto" @bind:event="oninput" disabled="@occupato" />
            </label>
            @if (Testi.MessaggioImporto(Denaro.Verifica(nuovoImporto, out _)) is string erroreImporto)
            {
                <p class="errore-campo">@erroreImporto</p>
            }

            <label class="campo">
                <span class="etichetta-campo">Descrizione</span>
                <input class="descrizione-spesa" type="text" maxlength="200" placeholder="Per cosa?"
                       @bind="nuovaDescrizione" @bind:event="oninput" disabled="@occupato" />
            </label>

            <label class="campo">
                <span class="etichetta-campo">Quando</span>
                @* min/max sono solo un aiuto del browser: né Blazor né il browser li fanno rispettare
                   in tutti i percorsi (si può digitare a mano nei segmenti dell'anno). La guardia vera
                   è DataRagionevole, in @code. *@
                <input class="data-spesa dato" type="date" min="2000-01-01" max="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")"
                       @bind="nuovaData" disabled="@occupato" />
            </label>
            @if (nuovaData is null)
            {
                <p class="errore-campo">Manca la data della spesa.</p>
            }
            else if (!DataRagionevole)
            {
                <p class="errore-campo">L'anno non è verosimile: dev'essere fra il 2000 e l'anno prossimo.</p>
            }
        </div>

        <fieldset class="scelta-categoria">
            <legend class="etichetta-campo">Categoria</legend>
            @foreach (var c in CategorieSpesa.Elenco)
            {
                <button type="button" class="pastiglia @(c == nuovaCategoria ? "accesa" : "")"
                        aria-pressed="@(c == nuovaCategoria)" @onclick="() => nuovaCategoria = c" disabled="@occupato">@c</button>
            }
        </fieldset>

        <div class="azioni">
            <button class="btn primario @(occupato ? "occupato" : "")" @onclick="Segna" disabled="@(occupato || !ModuloValido || rileggoMese)">Segna</button>
        </div>
    </section>

    @if (datiNonLetti)
    {
        <div class="vuoto">
            <p>Non sono riuscito a leggere le spese di questo spazio.</p>
            <button class="btn" @onclick="Riprova" disabled="@rileggoMese">Riprova</button>
        </div>
    }
    else
    {
        @* Il riepilogo sta FUORI dal controllo su speseDelMese.Count perché dentro ci sono le frecce
           ‹ › che cambiano mese: se restasse nel ramo "ci sono spese", un mese vuoto le farebbe
           sparire insieme al riepilogo, e non ci sarebbe più modo di uscirne — nemmeno per tornare a
           un mese che ha spese davvero. A lettura riuscita renderlo con zero spese è sicuro
           (riepilogo parte da new(0, [], 0, null)) e corretto: 0,00 € è vero quando il mese non è
           costato niente. È diverso dal ramo 'datiNonLetti' sopra, dove non si mostra alcun
           riepilogo perché lì lo zero sarebbe falso: non sappiamo quanto sia costato quel mese, solo
           che non siamo riusciti a leggerlo. *@
        @* scheda porta la superficie condivisa (sfondo, bordo, ombra); riepilogo-mese solo ciò che è proprio di questo blocco *@
        <section class="scheda riepilogo-mese">
            <div class="testa-registro">
                <span>@CalcoliSpese.NomeMese(mese) @anno</span>
                <div class="navigazione-mese">
                    @* rileggoMese in più su entrambe: due click rapidi lancerebbero due letture che
                       possono tornare in ordine inverso, lasciando mostrato il mese sbagliato. *@
                    <button type="button" class="btn piccolo" @onclick="MesePrecedente" disabled="@rileggoMese" aria-label="Mese precedente">‹</button>
                    <button type="button" class="btn piccolo" @onclick="MeseSuccessivo" disabled="@(!PuoAndareAvanti || rileggoMese)" aria-label="Mese successivo">›</button>
                </div>
            </div>

            @* @key sul VALORE, non su un indice statico: quando riepilogo.Totale cambia da un mese
               all'altro, Blazor non aggiorna l'elemento esistente — lo distrugge e ne crea uno
               nuovo, e un elemento appena inserito riesegue la propria animazione CSS
               (valore-cambia in app.css), cosa che un semplice aggiornamento di testo non farebbe.
               È il conteggio animato delle app di finanza, senza una riga di JavaScript.
               Confidenza media su questo meccanismo, non alta, e non verificato sui sorgenti di
               .NET 10: se si rivela sbagliato va corretto qui, non spacciato per funzionante. *@
            <p class="totale-mese dato valore-cambia" @key="riepilogo.Totale">@Denaro.Testo(riepilogo.Totale)&#160;€</p>
            <p class="confronto-mese testo-tenue">@TestoConfronto()</p>

            <ul class="barre-categorie">
                @foreach (var v in riepilogo.Categorie)
                {
                    <li>
                        <span class="nome-categoria">@v.Categoria</span>
                        <span class="barra"><span class="riempimento" style="width: @(v.Quota)%"></span></span>
                        <span class="quota dato">@v.Quota%</span>
                        <span class="totale-categoria dato">@Denaro.Testo(v.Totale)&#160;€</span>
                    </li>
                }
            </ul>
        </section>

        @if (rileggoMese)
        {
            @* Solo il registro, non il riepilogo qui sopra (v. il commento su rileggoMese in @code):
               le frecce hanno già cambiato l'intestazione del mese, e le barre hanno l'altezza vera
               di una riga (--altezza-riga) così il registro non salta di misura quando le spese
               arrivano. *@
            <Scheletro Righe="4" />
        }
        else if (speseDelMese.Count == 0)
        {
            <div class="vuoto">
                <p>Ancora nessuna spesa qui.</p>
            </div>
        }
        else
        {
            <div class="testa-registro">
                <span>@Testi.Conteggio(speseDelMese.Count, "spesa", "spese")</span>
            </div>

            <ul class="registro elenco-spese">
                @foreach (var s in speseDelMese)
                {
                    <li>
                        @* riga-nuova solo sulla spesa appena creata da Segna(), non su tutto ciò che è
                           "recente": il lampo verde dichiara un fatto CONSTATATO in questa sessione,
                           non una qualità della riga. Verde e non blu, come in app.css: blu è dove si
                           preme, verde è dove si constata — e questa riga non si è premuta, è arrivata
                           da sola dopo Segna(). *@
                        <a class="riga riga-spesa @(s.Id == ultimaSpesaCreataId ? "riga-nuova" : "")" href="expenses/@s.Id">
                            <span class="descrizione">@s.Description</span>
                            <span class="meta">
                                <span class="pastiglia">@s.Category</span>
                                <span class="dato">@Testi.DataSola(s.SpentOn)</span>
                                @if (Pagante(s) is string pagante)
                                {
                                    <text> · @pagante</text>
                                }
                            </span>
                            <span class="importo dato">@Denaro.Testo(s.Amount)&#160;€</span>
                        </a>
                    </li>
                }
            </ul>
        }
    }
}

@code {
    private int anno = DateTime.Now.Year;
    private int mese = DateTime.Now.Month;
    private RiepilogoMese riepilogo = new(0, [], 0, null);
    private IReadOnlyList<Expense> speseDelMese = [];
    private IReadOnlyList<Membro> membri = [];
    private bool occupato;

    // Vero mentre la pagina sta rileggendo dati che ha GIÀ — segnare una spesa, rileggere dopo un
    // errore, cambiare mese con le frecce — a differenza di 'caricato', che è falso solo quando non
    // c'è ancora niente da mostrare (primo montaggio, cambio di spazio) e per cui è giusto svuotare
    // tutto. Qui non è giusto: il modulo per segnare una spesa non ha nulla a che vedere con quale
    // lettura è in corso, e non deve sparire da sotto le dita di chi ci sta scrivendo. Il riepilogo
    // resta a schermo anche lui: solo l'elenco delle spese, più sotto, cede il posto a <Scheletro>.
    // Usato anche per disabilitare Segna, Riprova e le due frecce mentre una lettura è in volo, v.
    // il markup e il commento su Carica().
    private bool rileggoMese;

    // L'id di chi guarda, letto una volta sola all'apertura della pagina: serve sia a Segna(), per
    // valorizzare paid_by, sia a Pagante(), per decidere se il nome del pagante va scritto o no
    // accanto a una riga. Se il parsing fallisce resta null, e Pagante() finisce col mostrare
    // sempre il nome: un fallimento di questo genere non è un buco di sicurezza, la riga in più è
    // solo rumore.
    private Guid? mioId;

    private string nuovoImporto = "";
    private string nuovaDescrizione = "";
    private string nuovaCategoria = CategorieSpesa.Elenco[0];

    // DateTime? e non DateTime: con un tipo non annullabile lo stato "vuoto" non è rappresentabile,
    // e il binder di Blazor lo contrabbanda dentro un valore legale. Verificato decompilando
    // Microsoft.AspNetCore.Components 9.0.7: quando la conversione fallisce e il valore grezzo è la
    // stringa vuota (la "x" che Chrome mostra su un <input type="date">), il codice generato non
    // lascia il campo invariato — chiama setter(default(T)), cioè 0001-01-01. La colonna spent_on
    // non ha vincoli di intervallo: quella data entra nel database senza errori, e sparisce da ogni
    // riepilogo mensile perché l'anno 1 non ne intercetta nessuno. Con DateTime? il vuoto diventa
    // null, uno stato che si può controllare invece di uno che si insinua.
    private DateTime? nuovaData = DateTime.Today;

    // Guardia di ragionevolezza, non di validazione del dominio: non impedisce una spesa vera fuori
    // da questo intervallo (nessuno ne segnerebbe una), impedisce che un anno digitato a mano nei
    // segmenti dell'<input type="date"> — "0001" si scrive senza passare dalla "x" che svuota il
    // campo — diventi una spesa silenziosamente invisibile in ogni riepilogo mensile. Il limite è
    // arbitrario apposta.
    private bool DataRagionevole => nuovaData is { } d && d.Year >= 2000 && d.Year <= DateTime.Today.Year + 1;

    private bool ModuloValido => Denaro.Prova(nuovoImporto, out _) && !string.IsNullOrWhiteSpace(nuovaDescrizione) && DataRagionevole;

    // L'id dell'ultima spesa creata da Segna() in questa sessione della pagina, per darle il lampo
    // verde di riga-nuova nel registro qui sotto. Azzerato in Riprova, MesePrecedente,
    // MeseSuccessivo e SuCambioSpazio — cioè a ogni punto che rifà un giro di Carica() diverso da
    // quello innescato da Segna() stessa: senza, allontanarsi dal mese della spesa e tornarci
    // farebbe sparire e poi ricomparire la classe riga-nuova fra un render e l'altro, e Blazor
    // rifarebbe partire l'animazione CSS una seconda volta — il "lampo che si ripete" da evitare.
    private Guid? ultimaSpesaCreataId;

    // Falso solo quando il mese mostrato è quello corrente: non esistono spese future, e una
    // freccia che porta su una schermata sempre vuota è una freccia che non doveva esserci.
    private bool PuoAndareAvanti => anno != DateTime.Now.Year || mese != DateTime.Now.Month;

    protected override string NomePlurale => "le spese";

    protected override async Task OnInitializedAsync()
    {
        if (Guid.TryParse(await AuthState.GetUserIdAsync(), out var id)) mioId = id;
        await base.OnInitializedAsync();
    }

    // Come SpesaEdit.Crea: pagante letto con AuthState.GetUserIdAsync() e Guid.TryParse, stesso
    // messaggio se la sessione non è valida (v. Pages/NoteEdit.razor, il ramo in cui Guid.TryParse
    // fallisce dentro Crea). occupato è
    // ripristinato in un finally, altrimenti un'eccezione qui lascerebbe i campi disabilitati per
    // sempre.
    private async Task Segna()
    {
        occupato = true;
        // Alzato qui, prima del primo await, e non più avanti — subito prima di Carica() come
        // sembrerebbe più naturale: è questa posizione a rendere vera la regola per tutti e quattro
        // i chiamanti di Carica() (v. il commento lì). Se restasse dopo AssicuraCaricatoAsync,
        // GetUserIdAsync e soprattutto CreaAsync — un vero viaggio di rete — «Riprova» e le due
        // frecce del mese resterebbero cliccabili per tutta quella finestra: un click lì lancerebbe
        // una seconda Carica() in corsa con questa. Il costo accettato è che il registro diventa uno
        // scheletro anche durante CreaAsync, non solo durante la rilettura che segue — poche
        // centinaia di millisecondi in più — in cambio di un invariante verificabile leggendo quattro
        // righe invece di ragionare su due flag sovrapposti.
        rileggoMese = true;
        errore = null;
        try
        {
            if (!Denaro.Prova(nuovoImporto, out var importo)) return;
            if (string.IsNullOrWhiteSpace(nuovaDescrizione)) return;
            if (!DataRagionevole) return;

            var attivo = await Spazi.AssicuraCaricatoAsync();
            if (attivo is null)
            {
                errore = "Serve uno spazio attivo per segnare una spesa.";
                return;
            }

            if (!Guid.TryParse(await AuthState.GetUserIdAsync(), out var pagante))
            {
                errore = "La sessione non è più valida: esci e rientra.";
                return;
            }

            // DataRagionevole, appena sopra, ha già garantito che nuovaData non è null: CreaAsync
            // vuole un DateTime non annullabile.
            var creata = await Repository.CreaAsync(attivo.Id, pagante, importo, nuovaDescrizione, nuovaCategoria, nuovaData!.Value);
            ultimaSpesaCreataId = creata.Id;

            // Importo e descrizione si svuotano, data e categoria restano: chi segna tre spese al
            // supermercato le segna nello stesso giorno e spesso nella stessa categoria, e
            // riazzerarle costringerebbe a rimetterle ogni volta.
            nuovoImporto = "";
            nuovaDescrizione = "";

            await Carica();
        }
        catch (Exception ex)
        {
            // "Segnare" e non "salvare": è il verbo del pulsante che porta qui.
            //
            // La promessa "quello che hai scritto è ancora qui" è vera in ogni ramo raggiungibile, e
            // non è ovvia perché questo è un modulo di CREAZIONE, che dopo un successo si svuota:
            // nuovoImporto e nuovaDescrizione si azzerano solo DOPO che CreaAsync è tornata, quindi
            // ogni percorso che finisce in questo catch li lascia intatti. Data e categoria non si
            // azzerano mai.
            Console.Error.WriteLine($"[Spese] Spesa non segnata: {ex.Message}");
            errore = "Non è stato possibile segnare la spesa: il database ha rifiutato la scrittura, oppure non è stato raggiunto. Quello che hai scritto è ancora qui: riprova fra un momento.";
        }
        finally
        {
            occupato = false;
            rileggoMese = false;
        }
    }

    // Nessun chiamante deve entrare in Carica() (ereditato, Shared/PaginaRegistro.cs) mentre un
    // altro è in volo. I quattro percorsi da interfaccia — Segna, Riprova, le due frecce del mese —
    // si escludono a vicenda perché ciascuno alza rileggoMese come ULTIMA ISTRUZIONE SINCRONA PRIMA
    // DEL PRIMO AWAIT del proprio metodo, e ogni pulsante che li avvia è disabilitato quando
    // rileggoMese è vero. La posizione è la parte che conta: un flag alzato a metà metodo, dopo un
    // await, lascerebbe gli altri pulsanti cliccabili per tutta la durata della chiamata di rete che
    // precede — è esattamente l'errore corretto in Segna(), v. il commento lì.
    //
    // SuCambioSpazio (Shared/PaginaRegistro.cs) si esclude con due guardie separate, non una sola:
    // "if (inCaricamento) return;" — la prima delle due guardie in cima a PaginaRegistro.SuCambioSpazio —
    // che copre la finestra in cui Carica() è già in volo, e "if (ScartaCambioSpazio()) return;",
    // la seconda, che chiama
    // l'override qui sotto — quindi in pratica rileggoMese — e copre la finestra in cui un chiamante
    // l'ha già annunciata ma non l'ha ancora avviata. Chi aggiunge un quinto chiamante deve
    // procurarsi una delle due esclusioni, rispettando la stessa regola di posizione: due Carica() in
    // parallelo scrivono sugli stessi campi (riepilogo, speseDelMese, membri — di questa pagina — ed
    // errore, datiNonLetti, spazioMostrato — ereditati da PaginaRegistro), e vince l'ultima risposta
    // di rete invece dell'ultima azione dell'utente.
    //
    // rileggoMese in più, non solo inCaricamento: quel flag copre solo la finestra in cui Carica() è
    // già in volo, ma Segna() lo alza PRIMA di Carica(), mentre attraversa AssicuraCaricatoAsync,
    // GetUserIdAsync e CreaAsync — un vero viaggio di rete durante il quale inCaricamento è ancora
    // falso. Senza questo controllo, un cambio di spazio in quella finestra passerebbe la guardia e
    // partirebbe qui una seconda Carica() in corsa con quella che Segna() sta per lanciare.
    // Rinunciare non perde l'evento: Carica() cattura lo spazio attivo dentro il proprio ciclo, a
    // ogni giro (v. la variabile 'partenza' catturata in cima al ciclo di PaginaRegistro.Carica),
    // quindi la Carica() che il percorso in corso
    // lancerà comunque legge già lo spazio nuovo al primo giro — è la stessa logica per cui quel
    // ciclo esiste, estesa a questa seconda finestra.
    protected override bool ScartaCambioSpazio() => rileggoMese;

    protected override void PrimaDiRicaricare() => ultimaSpesaCreataId = null;

    protected override async Task Leggi(Space attivo)
    {
        riepilogo = new RiepilogoMese(0, [], 0, null);
        speseDelMese = [];
        membri = [];

        // Il mese precedente di gennaio è dicembre dell'anno prima: stessa regola di
        // CalcoliSpese.PerMese, ripetuta qui perché è l'intervallo da chiedere al repository, non
        // il calcolo del confronto.
        var mesePrima = mese == 1 ? 12 : mese - 1;
        var annoMesePrima = mese == 1 ? anno - 1 : anno;
        var da = new DateTime(annoMesePrima, mesePrima, 1);
        var a = new DateTime(anno, mese, DateTime.DaysInMonth(anno, mese));

        try
        {
            // Una sola lettura copre due mesi: CalcoliSpese.PerMese ha bisogno anche del mese
            // precedente per calcolare il confronto, e chiederlo qui invece che con una seconda
            // query risparmia un viaggio di rete (v. ExpenseRepository.ElencaAsync).
            var spese = await Repository.ElencaAsync(attivo.Id, da, a);
            riepilogo = CalcoliSpese.PerMese(spese, anno, mese);
            speseDelMese = spese.Where(s => s.SpentOn.Year == anno && s.SpentOn.Month == mese).ToList();
        }
        catch (Exception ex)
        {
            SegnalaNonLetti(ex);
            return;
        }

        // Letti sempre, non solo negli spazi condivisi: chi ha pagato si nasconde riga per riga in
        // Pagante(), non allo spazio intero — v. il commento lì per il perché. Non rimettere qui un
        // controllo su IsPersonal.

        // Try separato, e non insieme alle spese: i membri servono soltanto a scrivere il nome del
        // pagante accanto a ogni spesa. Metterli nello stesso catch faceva sì che un timeout su
        // questa seconda chiamata dichiarasse illeggibili delle spese già lette benissimo, e le
        // nascondesse dietro un messaggio d'errore falso. Un fallimento qui lascia Pagante() a
        // null, e la riga mostra comunque categoria e data — che sono l'informazione principale:
        // non è un errore da mostrare, ma va detto in console, altrimenti resta invisibile.
        try
        {
            membri = await SpaziRepository.MembriAsync(attivo.Id);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Spese] Nomi dei paganti non disponibili: {ex.Message}");
        }
    }

    // Riprova() non usa quella ereditata: qui rileggere è uno dei quattro percorsi che alzano
    // rileggoMese (v. il commento sopra ScartaCambioSpazio) e non caricato, così il modulo per
    // segnare una spesa e il riepilogo del mese restano a schermo invece di sparire sotto uno
    // <Scheletro>. L'override è deliberato, non una svista: non va "semplificato" verso quello
    // ereditato.
    protected override async Task Riprova()
    {
        ultimaSpesaCreataId = null;
        rileggoMese = true;
        try
        {
            await Carica();
        }
        finally
        {
            rileggoMese = false;
        }
    }

    // rileggoMese e non caricato: v. il commento sul campo. CaricaUnGiro azzera comunque riepilogo a
    // new(0, [], 0, null) prima di rileggere — lo fa anche per il cambio spazio, dove è necessario
    // per non far passare il riepilogo di uno spazio per quello di un altro — quindi il totale può
    // mostrare 0,00 € per un istante prima che arrivi quello del mese nuovo, invece di restare fermo
    // sul valore del mese precedente. Scelta deliberata e non una svista: tenere il vecchio valore
    // sotto un'intestazione che nel frattempo mostra già il mese nuovo sarebbe fuorviante allo stesso
    // modo del cambio spazio, e duplicare la logica di CaricaUnGiro solo per questo caso non vale la
    // complessità in più.
    private async Task MesePrecedente()
    {
        if (mese == 1) { anno--; mese = 12; } else { mese--; }
        ultimaSpesaCreataId = null;
        rileggoMese = true;
        try
        {
            await Carica();
        }
        finally
        {
            rileggoMese = false;
        }
    }

    private async Task MeseSuccessivo()
    {
        if (mese == 12) { anno++; mese = 1; } else { mese++; }
        ultimaSpesaCreataId = null;
        rileggoMese = true;
        try
        {
            await Carica();
        }
        finally
        {
            rileggoMese = false;
        }
    }

    // La frase sotto il totale: il segno lo decide CalcoliSpese.PerMese, che confronta il totale di
    // questo mese con quello precedente (v. il commento su VariazionePercentuale). I casi sono tre,
    // non due: null è la percentuale che non esiste (il mese scorso era a zero, non si può dividere);
    // 0 è la percentuale che esiste e vale zero (i due mesi si equivalgono). Sono due "niente" diversi,
    // la stessa distinzione che qui sopra fa datiNonLetti fra "non c'è niente" e "non ho potuto
    // leggere niente" — ereditato da PaginaRegistro, non più un campo di questa pagina — e vanno
    // detti diversi.
    private string TestoConfronto()
    {
        if (riepilogo.VariazionePercentuale is not { } variazione)
            return "Nessuna spesa il mese scorso.";

        if (variazione == 0)
            return "Come il mese scorso.";

        return variazione > 0
            ? $"Il {variazione}% in più del mese scorso."
            : $"Il {Math.Abs(variazione)}% in meno del mese scorso.";
    }

    // Separato dalla data perché nel markup quella va in un <span class="dato"> a sé, per renderla
    // in carattere monospaziato: il nome di una persona non è un dato e non ci va.
    //
    // Solo quando paid_by differisce da mioId, non "solo negli spazi condivisi": quella regola
    // richiederebbe di conoscere il numero di membri, cioè una query in più, e darebbe lo stesso
    // risultato, perché in uno spazio personale paid_by non differisce mai da chi guarda. La
    // condizione economica è anche la più precisa, perché in uno spazio condiviso nasconde
    // comunque il rumore delle proprie righe.
    private string? Pagante(Expense s) => s.PaidBy != mioId ? membri.FirstOrDefault(m => m.UtenteId == s.PaidBy)?.Nome : null;
}
