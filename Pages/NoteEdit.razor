@page "/notes/new"
@page "/notes/{Id:guid}"
@using Eton.Models
@inherits PaginaEditor
@inject NoteRepository Repository
@inject SpaceStateService Spazi
@inject AuthStateService AuthState

<PageTitle>@TitoloSchermata — Eton</PageTitle>

<TestataPagina Titolo="@TitoloSchermata">
    <Aiuto>
        <p>Il testo si scrive in Markdown: la scheda Anteprima mostra come verrà.</p>
        <p>Se qualcun altro salva questa nota mentre la stai scrivendo, il salvataggio si ferma e ti fa scegliere fra ricaricare la sua versione e sovrascrivere con la tua.</p>
        <p>Uscendo con modifiche non salvate arriva una domanda: il lavoro in corso non si perde per sbaglio.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <p class="avvio">Caricamento…</p>
}
else if (sparita)
{
    <div class="vuoto">
        <p>Questa nota non c'è più: l'ha cancellata qualcuno, oppure non fai più parte dello spazio.</p>
        <a class="btn" href="notes">Torna alle note</a>
    </div>
}
else if (nota is null && !Nuova)
{
    <div class="vuoto">
        <div class="errore" role="alert">@errore</div>
        <a class="btn" href="notes">Torna alle note</a>
    </div>
}
else
{
    <NavigationLock ConfirmExternalNavigation="@Cambiata" OnBeforeInternalNavigation="GuardaUscita" />

    @if (conflitto is not null)
    {
        @* !PuoIntervenire in più: anche Sovrascrivi scrive nel database, e la RLS la
           rifiuterebbe agli stessi soggetti a cui Salva è vietato — v. il commento su
           PuoIntervenire più sotto. *@
        <SchedaConflitto Premessa="Mentre scrivevi, questa nota è cambiata." Occupato="@occupato" SovrascriviAbilitato="@PuoIntervenire"
                         OnRicarica="Ricarica" OnSovrascrivi="Sovrascrivi" />
    }

    @* PuoIntervenire (v. @code) decide se questi campi si possono toccare. Sotto la spiegazione e
       non sopra: chi legge dall'alto trova prima i dati della nota, poi capisce perché non può
       cambiarli. *@
    @if (!PuoIntervenire)
    {
        <p class="spiega">@Permessi.Spiegazione(Permessi.Oggetto.Nota)</p>
    }

    <input class="titolo-nota" type="text" placeholder="Titolo" maxlength="200"
           @bind="titolo" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />

    <div class="schede-testo">
        <button type="button" class="@(anteprima ? "" : "attiva")" @onclick="() => anteprima = false">Scrivi</button>
        <button type="button" class="@(anteprima ? "attiva" : "")" @onclick="() => anteprima = true">Anteprima</button>
    </div>

    @if (anteprima)
    {
        <MarkdownView Testo="@corpo" />
    }
    else
    {
        @* maxlength rispecchia il check (length(body) <= 100000) della migrazione: senza, il limite
           si scopre solo al salvataggio, sotto forma di errore Postgres grezzo, a testo già scritto.
           È leggermente più severo del database — il browser conta unità UTF-16, Postgres conta
           caratteri, quindi un'emoji vale 2 qui e 1 di là. Sbagliare per eccesso di prudenza va
           bene: non lascia mai passare qualcosa che il database poi rifiuta. *@
        <textarea class="corpo-nota" maxlength="100000" @bind="corpo" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)"
                  placeholder="@("Scrivi in Markdown.\n\n**grassetto**  *corsivo*  # titolo\n- [ ] da fare\n- [x] fatto")"></textarea>
    }

    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }
    @if (avviso is not null)
    {
        <div class="avviso" role="status">@avviso</div>
    }

    @* Perché il pulsante è spento, e solo quando non è già scritto altrove: 'occupato' lo dice il
       pulsante stesso, che intanto legge «Salvo…»; '!PuoIntervenire' lo dice la riga .spiega in
       cima alla pagina; il conflitto lo dice SchedaConflitto. Resta scoperto solo !Cambiata, che
       oggi non lascia niente da leggere e si scopre per tentativi.
       'testo-tenue' e non 'errore-campo': è un'istruzione, non un rimprovero — su /notes/new il
       modulo nasce vuoto per costruzione, e accoglierlo con una riga rossa darebbe la colpa di un
       errore a chi non ha ancora fatto niente. Stessa forma di Pages/CollectionEdit.razor. *@
    @if (!occupato && PuoIntervenire && conflitto is null && !Cambiata)
    {
        <p class="testo-tenue">
            @(Nuova
                ? "Scrivi il titolo o il testo della nota per poterla salvare."
                : "Non c'è niente da salvare: non hai ancora cambiato niente.")
        </p>
    }

    <div class="azioni">
        @* Anche 'conflitto is null': con la scheda del conflitto aperta il pulsante resterebbe
           acceso, perché il testo è davvero diverso da quello di 'nota'. Ripremerlo risalverebbe
           con la versione vecchia — stesso conflitto, altro giro a vuoto — e scavalcherebbe in
           silenzio la scelta fra Ricarica e Sovrascrivi, che è l'unico modo di uscirne. *@
        <button class="btn primario" @onclick="Salva" disabled="@(occupato || !Cambiata || conflitto is not null || !PuoIntervenire)">
            @(occupato ? "Salvo…" : "Salva")
        </button>
        <a class="btn" href="@(occupato ? null : "notes")">Chiudi</a>

        @* Elimina sparisce del tutto quando PuoIntervenire è falso, non si disabilita — un pulsante
           grigio inviterebbe comunque a chiedersi il motivo, e qui la risposta non starebbe da
           nessuna parte (v. il commento su PuoIntervenire più sotto). *@
        @if (!Nuova && PuoIntervenire)
        {
            <ConfermaAzione Chiave="@Id" Occupato="@occupato" OnConferma="Elimina" />
        }
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Note? nota;        // l'ultima versione conosciuta del server: da qui esce la versione
    private Note? conflitto;   // la versione altrui, quando il salvataggio si è scontrato
    private string titolo = "";
    private string corpo = "";
    private bool caricato, occupato, anteprima, sparita;
    private string? errore, avviso;
    private int generazione;

    // L'id di chi guarda, come mioId in Pages/SpesaEdit.razor: stesso pattern, GetUserIdAsync() più
    // Guid.TryParse. Letto in OnParametersSetAsync qui sotto e non in OnInitializedAsync come in
    // SpesaEdit, perché questa pagina rilancia il ciclo di vita sulla stessa istanza a ogni cambio
    // di rotta (v. il commento sotto), e rileggerlo lì costerebbe una chiamata in più senza motivo:
    // qui basta che sia pronto prima che il render legga PuoIntervenire, e OnParametersSetAsync gira
    // comunque a ogni apertura. Se il parsing fallisce resta null, e PuoIntervenire ne tiene conto
    // fallendo chiuso.
    private Guid? mioId;

    private bool Nuova => Id is null;

    private string TitoloSchermata => string.IsNullOrWhiteSpace(titolo) ? "Nota" : titolo;

    // Il pulsante Salva resta spento finché non c'è niente da salvare: su una nota lunga evita il
    // salvataggio a vuoto, che incrementerebbe comunque la versione e farebbe scattare un
    // conflitto a chi la sta scrivendo davvero.
    protected override bool Cambiata => Nuova
        ? !string.IsNullOrWhiteSpace(titolo) || !string.IsNullOrWhiteSpace(corpo)
        : nota is not null && (titolo != nota.Title || corpo != nota.Body);

    // Nuova per prima: su /notes/new la nota non esiste ancora, e chiedere a Permessi "sei tu
    // l'autore?" di un oggetto non creato risponderebbe no, bloccando la creazione. V.
    // Services/Permessi.cs per il perché di ogni altra scelta qui dentro.
    private bool PuoIntervenire => Nuova
        || (nota is not null && Permessi.PuoIntervenire(mioId, nota.OwnerId, nota.SpaceId, Spazi.Elenco));

    // Come in SpaceDetail: passando da /notes/new a /notes/{id} dopo la creazione Blazor riusa
    // QUESTA istanza e cambia solo il parametro, quindi due caricamenti possono sovrapporsi e
    // quello partito prima può rispondere per ultimo.
    protected override async Task OnParametersSetAsync()
    {
        var mia = ++generazione;

        caricato = false;
        errore = avviso = null;
        conflitto = null;
        sparita = anteprima = false;

        try
        {
            // Prima che il render possa leggere PuoIntervenire: senza, Spazi.Elenco sarebbe ancora
            // vuoto quando questa è la prima pagina aperta (da un collegamento diretto), e
            // PuoIntervenire fallirebbe chiuso nascondendo i pulsanti anche a chi ha tutti i diritti
            // di premerli — peggio del messaggio di rifiuto che questa pagina mostrava finora.
            await Spazi.AssicuraCaricatoAsync();
            if (Guid.TryParse(await AuthState.GetUserIdAsync(), out var id)) mioId = id;

            // I due await appena sopra sono punti di sospensione: se nel frattempo è partita una nuova
            // invocazione (altra nota, o questa stessa pagina riaperta), quanto segue non è più
            // atomico rispetto a quella. Senza questo controllo, un'invocazione vecchia risvegliata in
            // ritardo rientrerebbe qui e, sul ramo Nuova, cancellerebbe in silenzio il testo che
            // l'utente ha già iniziato a scrivere nella pagina nel frattempo riaperta.
            if (mia != generazione) return;

            if (Nuova)
            {
                nota = null;
                titolo = corpo = "";
                caricato = true;
                return;
            }

            var letta = await Repository.LeggiAsync(Id!.Value);
            if (mia != generazione) return;

            nota = letta;
            if (nota is null)
            {
                sparita = true;
            }
            else
            {
                titolo = nota.Title;
                corpo = nota.Body;
            }
        }
        catch (Exception ex)
        {
            if (mia != generazione) return;

            // 'nota = null' e non solo 'caricato = true': al primo caricamento 'nota' è già null,
            // quindi azzerarla non cambia niente. Il caso che conta è la navigazione da una nota a
            // un'altra — Blazor riusa questa istanza e 'nota' contiene ancora quella precedente —
            // dove senza l'azzeramento il modulo si aprirebbe con il contenuto della nota vecchia
            // sotto l'indirizzo della nota nuova: dati sbagliati presentati come giusti. Con 'nota'
            // a null e '!Nuova' scatta invece il ramo d'errore qui sopra.
            // In creazione, però, il modulo resta accessibile lo stesso: qui a fallire è solo
            // l'elenco degli spazi, che serve esclusivamente a calcolare PuoIntervenire — e in
            // creazione PuoIntervenire è vero incondizionatamente (v. 'Nuova ||' più sotto), quindi
            // questo guasto non tocca nulla di ciò che l'utente sta per fare. Crea() richiama
            // Spazi.AssicuraCaricatoAsync() per conto proprio, quindi la rete viene ritentata nel
            // momento in cui serve davvero.
            nota = null;
            // Il testo dell'eccezione NON va all'utente: quando è una PostgrestException, Message è
            // il corpo JSON della risposta — SQLSTATE, nome della tabella e, sul 42501, perfino il
            // GRANT da eseguire, cioè istruzioni per un amministratore di database mostrate a chi
            // voleva solo aprire una nota. In console ci va invece per intero, così la diagnosi non
            // si perde. Vale per tutti i catch qui sotto.
            Console.Error.WriteLine($"[Note] Apertura non riuscita: {ex.Message}");
            errore = "Non è stato possibile aprire la nota: può essere la connessione, oppure il tuo accesso a questo spazio che è cambiato. Riprova fra un momento.";
        }

        caricato = true;
    }

    private async Task Salva()
    {
        occupato = true; errore = avviso = null; conflitto = null;
        try
        {
            if (Nuova)
            {
                await Crea();
                return;
            }

            await SalvaCon(nota!.Version);
        }
        catch (Exception ex)
        {
            // v. il commento nel catch di OnParametersSetAsync: il JSON in console, la frase
            // all'utente. Qui in più conta dire che il lavoro non è perso, perché è la prima
            // domanda di chi ha appena visto fallire un salvataggio — e per la stessa ragione
            // l'azione suggerita è riprovare, mai ricaricare: una ricarica butterebbe via
            // esattamente ciò che non è stato scritto.
            Console.Error.WriteLine($"[Note] Salvataggio non riuscito: {ex.Message}");
            errore = "Non è stato possibile salvare: il database ha rifiutato la scrittura, oppure non è stato raggiunto. Quello che hai scritto è ancora qui: riprova fra un momento, e non chiudere la pagina.";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Crea()
    {
        var attivo = await Spazi.AssicuraCaricatoAsync();
        if (attivo is null)
        {
            errore = "Serve uno spazio attivo per creare una nota.";
            return;
        }

        if (!Guid.TryParse(await AuthState.GetUserIdAsync(), out var autore))
        {
            errore = "La sessione non è più valida: esci e rientra.";
            return;
        }

        var creata = await Repository.CreaAsync(attivo.Id, autore, titolo, corpo);

        // replace: true perché /notes/new non è un posto in cui tornare col tasto Indietro — la
        // nota ormai esiste, e ripresentare la schermata vuota ne farebbe creare una seconda.
        // Il cambio di rotta rilancia OnParametersSetAsync su questa stessa istanza, che rilegge
        // la nota: solo da quel momento c'è una versione con cui fare concorrenza ottimistica.
        // Esci e non NavigateTo: qui la guardia va disarmata, il salvataggio è riuscito (v. PaginaEditor.Esci).
        Esci($"notes/{creata.Id}", replace: true);
    }

    private async Task SalvaCon(int versione)
    {
        var esito = await Repository.SalvaAsync(Id!.Value, versione, titolo, corpo);

        switch (esito.Esito)
        {
            case EsitoSalvataggio.Salvata:
                nota = esito.Aggiornata;
                titolo = nota!.Title;
                corpo = nota.Body;
                avviso = "Salvata.";
                break;

            case EsitoSalvataggio.Conflitto:
                conflitto = esito.Aggiornata;
                break;

            case EsitoSalvataggio.Rifiutata:
                // Con PuoIntervenire attivo, arrivare qui vuol dire che quel pre-controllo si è
                // rivelato sbagliato o stantio — per esempio la proprietà dello spazio è cambiata
                // mentre la pagina era aperta. È l'unico punto in cui non si può affermare la
                // regola con sicurezza, quindi non la si riscrive qui: si dice il fatto, si
                // suggerisce la causa senza giurarci, e si indica l'azione.
                errore = "Non hai più il permesso di modificare questa nota: può essere cambiato qualcosa nello spazio. Ricarica la pagina.";
                break;

            case EsitoSalvataggio.Sparita:
                sparita = true;
                break;
        }
    }

    private void Ricarica()
    {
        if (conflitto is null) return;

        nota = conflitto;
        titolo = conflitto.Title;
        corpo = conflitto.Body;
        conflitto = null;
        avviso = "Caricata la versione più recente.";
    }

    private async Task Sovrascrivi()
    {
        if (conflitto is null) return;

        occupato = true; errore = null;
        try
        {
            // Si risalva con la versione DEL SERVER, non con quella che si aveva in mano: è
            // esattamente ciò che "sovrascrivi" vuol dire — prendere atto che l'altro ha scritto
            // e scriverci sopra lo stesso. Se nel frattempo arriva un terzo salvataggio questo
            // fallisce di nuovo con Conflitto, ed è il comportamento giusto.
            var versione = conflitto.Version;
            conflitto = null;
            await SalvaCon(versione);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Note] Sovrascrittura non riuscita: {ex.Message}");
            errore = "Non è stato possibile sovrascrivere: il database ha rifiutato la scrittura, oppure non è stato raggiunto. Quello che hai scritto è ancora qui: riprova fra un momento, e non chiudere la pagina.";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Elimina()
    {
        occupato = true; errore = null;
        try
        {
            if (await Repository.EliminaAsync(Id!.Value))
            {
                // Esci e non NavigateTo: qui la guardia va disarmata, l'eliminazione è riuscita (v. PaginaEditor.Esci).
                Esci("notes");
                return;
            }
            // Rifiuto, non guasto: EliminaAsync ha reso false. Le parole della regola vengono da
            // Services/Permessi.cs, la formulazione canonica, e non da una riformulazione: quella
            // stessa frase compare su questa pagina quando !PuoIntervenire, e due modi di dire la
            // stessa regola a due centimetri di distanza sembrano due regole. Non si riusa
            // Spiegazione() testualmente perché apre affermando che la nota è di qualcun altro, e
            // qui è una delle due ipotesi, non un fatto.
            errore = "Non è stato possibile eliminare la nota: può cancellarla solo chi l'ha scritta, o chi possiede lo spazio. Può anche darsi che qualcun altro l'abbia già eliminata: ricarica la pagina per vedere com'è adesso.";
        }
        catch (Exception ex)
        {
            // Nessuna promessa "la nota è ancora al suo posto", a differenza della frase gemella di
            // Pages/CollectionEdit.razor: NoteRepository.EliminaAsync fa TRE chiamate di rete —
            // lettura preventiva, DELETE, rilettura di conferma — quindi un'eccezione può scoppiare
            // DOPO una cancellazione riuscita, e la promessa sarebbe falsa in un caso raggiungibile.
            Console.Error.WriteLine($"[Note] Eliminazione non riuscita: {ex.Message}");
            errore = "Non è stato possibile eliminare: il database ha rifiutato la cancellazione, oppure non è stato raggiunto. Ricarica la pagina per vedere se la nota c'è ancora.";
        }
        finally
        {
            occupato = false;
        }
    }
}
