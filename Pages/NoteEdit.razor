@page "/notes/new"
@page "/notes/{Id:guid}"
@using Eton.Models
@inject NoteRepository Repository
@inject SpaceStateService Spazi
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>@(string.IsNullOrWhiteSpace(titolo) ? "Nota" : titolo) — Eton</PageTitle>

@if (!caricato)
{
    <p class="avvio">Caricamento…</p>
}
else if (sparita)
{
    <div class="vuoto">
        <p>Questa nota non c'è più: l'ha cancellata qualcuno, oppure non fai più parte dello spazio.</p>
        <a class="btn" href="notes">Torna alle note</a>
    </div>
}
else if (nota is null && !Nuova)
{
    <div class="vuoto">
        <div class="errore" role="alert">@errore</div>
        <a class="btn" href="notes">Torna alle note</a>
    </div>
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }
    @if (avviso is not null)
    {
        <div class="avviso" role="status">@avviso</div>
    }

    @if (conflitto is not null)
    {
        <div class="scheda pericolo">
            <h2>Qualcun altro ha salvato prima di te</h2>
            <p class="testo-tenue">
                Mentre scrivevi, questa nota è cambiata. Sovrascrivendo si perde il lavoro
                dell'altra persona; ricaricando si perde il tuo.
            </p>
            <div class="azioni">
                <button class="btn" @onclick="Ricarica" disabled="@occupato">Ricarica la sua</button>
                <button class="btn rosso" @onclick="Sovrascrivi" disabled="@occupato">Sovrascrivi con la mia</button>
            </div>
        </div>
    }

    <input class="titolo-nota" type="text" placeholder="Titolo" maxlength="200"
           @bind="titolo" @bind:event="oninput" disabled="@occupato" />

    <div class="schede-testo">
        <button type="button" class="@(anteprima ? "" : "attiva")" @onclick="() => anteprima = false">Scrivi</button>
        <button type="button" class="@(anteprima ? "attiva" : "")" @onclick="() => anteprima = true">Anteprima</button>
    </div>

    @if (anteprima)
    {
        <MarkdownView Testo="@corpo" />
    }
    else
    {
        @* maxlength rispecchia il check (length(body) <= 100000) della migrazione: senza, il limite
           si scopre solo al salvataggio, sotto forma di errore Postgres grezzo, a testo già scritto.
           È leggermente più severo del database — il browser conta unità UTF-16, Postgres conta
           caratteri, quindi un'emoji vale 2 qui e 1 di là. Sbagliare per eccesso di prudenza va
           bene: non lascia mai passare qualcosa che il database poi rifiuta. *@
        <textarea class="corpo-nota" rows="16" maxlength="100000" @bind="corpo" @bind:event="oninput" disabled="@occupato"
                  placeholder="Scrivi in Markdown.&#10;&#10;**grassetto**  *corsivo*  # titolo&#10;- [ ] da fare&#10;- [x] fatto"></textarea>
    }

    <div class="azioni">
        @* Anche 'conflitto is null': con la scheda del conflitto aperta il pulsante resterebbe
           acceso, perché il testo è davvero diverso da quello di 'nota'. Ripremerlo risalverebbe
           con la versione vecchia — stesso conflitto, altro giro a vuoto — e scavalcherebbe in
           silenzio la scelta fra Ricarica e Sovrascrivi, che è l'unico modo di uscirne. *@
        <button class="btn primario" @onclick="Salva" disabled="@(occupato || !Cambiata || conflitto is not null)">
            @(occupato ? "Salvo…" : "Salva")
        </button>
        <a class="btn" href="notes">Chiudi</a>

        @if (!Nuova)
        {
            @if (confermaEliminazione)
            {
                <button class="btn rosso" @onclick="Elimina" disabled="@occupato">Sì, elimina</button>
                <button class="btn" @onclick="() => confermaEliminazione = false" disabled="@occupato">Annulla</button>
            }
            else
            {
                <button class="btn rosso" @onclick="() => confermaEliminazione = true" disabled="@occupato">Elimina</button>
            }
        }
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Note? nota;        // l'ultima versione conosciuta del server: da qui esce la versione
    private Note? conflitto;   // la versione altrui, quando il salvataggio si è scontrato
    private string titolo = "";
    private string corpo = "";
    private bool caricato, occupato, anteprima, sparita, confermaEliminazione;
    private string? errore, avviso;
    private int generazione;

    private bool Nuova => Id is null;

    // Il pulsante Salva resta spento finché non c'è niente da salvare: su una nota lunga evita il
    // salvataggio a vuoto, che incrementerebbe comunque la versione e farebbe scattare un
    // conflitto a chi la sta scrivendo davvero.
    private bool Cambiata => Nuova
        ? !string.IsNullOrWhiteSpace(titolo) || !string.IsNullOrWhiteSpace(corpo)
        : nota is not null && (titolo != nota.Title || corpo != nota.Body);

    // Come in SpaceDetail: passando da /notes/new a /notes/{id} dopo la creazione Blazor riusa
    // QUESTA istanza e cambia solo il parametro, quindi due caricamenti possono sovrapporsi e
    // quello partito prima può rispondere per ultimo.
    protected override async Task OnParametersSetAsync()
    {
        var mia = ++generazione;

        caricato = false;
        errore = avviso = null;
        conflitto = null;
        sparita = confermaEliminazione = anteprima = false;

        if (Nuova)
        {
            nota = null;
            titolo = corpo = "";
            caricato = true;
            return;
        }

        try
        {
            var letta = await Repository.LeggiAsync(Id!.Value);
            if (mia != generazione) return;

            nota = letta;
            if (nota is null)
            {
                sparita = true;
            }
            else
            {
                titolo = nota.Title;
                corpo = nota.Body;
            }
        }
        catch (Exception ex)
        {
            if (mia != generazione) return;
            nota = null;
            errore = $"Non è stato possibile aprire la nota: {ex.Message}";
        }

        caricato = true;
    }

    private async Task Salva()
    {
        occupato = true; errore = avviso = null; conflitto = null;
        try
        {
            if (Nuova)
            {
                await Crea();
                return;
            }

            await SalvaCon(nota!.Version);
        }
        catch (Exception ex)
        {
            errore = $"Non è stato possibile salvare: {ex.Message}";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Crea()
    {
        var attivo = await Spazi.AssicuraCaricatoAsync();
        if (attivo is null)
        {
            errore = "Serve uno spazio attivo per creare una nota.";
            return;
        }

        if (!Guid.TryParse(await AuthState.GetUserIdAsync(), out var autore))
        {
            errore = "La sessione non è più valida: esci e rientra.";
            return;
        }

        var creata = await Repository.CreaAsync(attivo.Id, autore, titolo, corpo);

        // replace: true perché /notes/new non è un posto in cui tornare col tasto Indietro — la
        // nota ormai esiste, e ripresentare la schermata vuota ne farebbe creare una seconda.
        // Il cambio di rotta rilancia OnParametersSetAsync su questa stessa istanza, che rilegge
        // la nota: solo da quel momento c'è una versione con cui fare concorrenza ottimistica.
        Navigation.NavigateTo($"notes/{creata.Id}", replace: true);
    }

    private async Task SalvaCon(int versione)
    {
        var esito = await Repository.SalvaAsync(Id!.Value, versione, titolo, corpo);

        switch (esito.Esito)
        {
            case EsitoSalvataggio.Salvata:
                nota = esito.Aggiornata;
                titolo = nota!.Title;
                corpo = nota.Body;
                avviso = "Salvata.";
                break;

            case EsitoSalvataggio.Conflitto:
                conflitto = esito.Aggiornata;
                break;

            case EsitoSalvataggio.Rifiutata:
                errore = "Il database ha rifiutato la modifica: questa nota può cambiarla solo chi l'ha scritta, o chi possiede lo spazio.";
                break;

            case EsitoSalvataggio.Sparita:
                sparita = true;
                break;
        }
    }

    private void Ricarica()
    {
        if (conflitto is null) return;

        nota = conflitto;
        titolo = conflitto.Title;
        corpo = conflitto.Body;
        conflitto = null;
        avviso = "Caricata la versione più recente.";
    }

    private async Task Sovrascrivi()
    {
        if (conflitto is null) return;

        occupato = true; errore = null;
        try
        {
            // Si risalva con la versione DEL SERVER, non con quella che si aveva in mano: è
            // esattamente ciò che "sovrascrivi" vuol dire — prendere atto che l'altro ha scritto
            // e scriverci sopra lo stesso. Se nel frattempo arriva un terzo salvataggio questo
            // fallisce di nuovo con Conflitto, ed è il comportamento giusto.
            var versione = conflitto.Version;
            conflitto = null;
            await SalvaCon(versione);
        }
        catch (Exception ex)
        {
            errore = $"Non è stato possibile sovrascrivere: {ex.Message}";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Elimina()
    {
        occupato = true; errore = null;
        try
        {
            if (await Repository.EliminaAsync(Id!.Value))
            {
                Navigation.NavigateTo("notes");
                return;
            }
            errore = "Il database ha rifiutato l'eliminazione.";
        }
        catch (Exception ex)
        {
            errore = $"Non è stato possibile eliminare: {ex.Message}";
        }
        finally
        {
            occupato = false;
            confermaEliminazione = false;
        }
    }
}
