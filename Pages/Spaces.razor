@page "/spaces"
@using Eton.Models
@inject SpaceRepository Repository
@inject SpaceStateService Spazi
@inject NavigationManager Navigation

<PageTitle>Spazi — Eton</PageTitle>

<TestataPagina Titolo="I tuoi spazi">
    <Aiuto>
        <p>Uno spazio si condivide col codice invito: chi ce l'ha entra e vede tutto quello che contiene. Lo spazio personale non si condivide.</p>
        <p>Da uno spazio condiviso si può uscire dalla sua pagina: smetti di vederne il contenuto, ma puoi rientrare col codice.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <Scheletro Righe="4" />
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }

    <div class="testa-registro">
        <span>@Testi.Conteggio(Spazi.Elenco.Count, "spazio", "spazi")</span>
    </div>
    <ul class="registro elenco-spazi">
        @foreach (var s in Spazi.Elenco)
        {
            <li>
                <a class="riga riga-spazio" href="spaces/@s.Id">
                    <span class="nome">@s.Name</span>
                    @if (s.IsPersonal)
                    {
                        <span class="pastiglia">personale</span>
                    }
                    @if (s.Id == Spazi.Attivo?.Id)
                    {
                        <span class="pastiglia accesa">attivo</span>
                    }
                </a>
            </li>
        }
    </ul>

    <div class="scheda">
        <h2>Crea uno spazio</h2>
        <p class="testo-tenue">Ne diventi il proprietario, e ottieni un codice da dare agli altri.</p>
        <div class="campo">
            <input type="text" placeholder="Nome dello spazio" maxlength="60"
                   @bind="nuovoNome" @bind:event="oninput" disabled="@occupato" />
            <button class="btn primario" @onclick="Crea"
                    disabled="@(occupato || string.IsNullOrWhiteSpace(nuovoNome))">Crea</button>
        </div>
    </div>

    <div class="scheda">
        <h2>Entra con un codice</h2>
        <p class="testo-tenue">Fattelo dare da chi ha creato lo spazio.</p>
        <div class="campo">
            <input type="text" placeholder="Codice invito" maxlength="8" class="codice-invito"
                   @bind="codice" @bind:event="oninput" disabled="@occupato" />
            <button class="btn primario" @onclick="Entra"
                    disabled="@(occupato || string.IsNullOrWhiteSpace(codice))">Entra</button>
        </div>
    </div>
}

@code {
    private bool caricato;
    private bool occupato;
    private string? errore;
    private string nuovoNome = "";
    private string codice = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Spazi.AssicuraCaricatoAsync();
        }
        catch (Exception ex)
        {
            // Le pagine gestiscono già l'errore delle mutazioni; il caricamento non lo faceva, e
            // un blip di rete finiva nel riquadro di crash di Blazor.
            //
            // L'azione è "ricarica la pagina" e non "riprova": qui il messaggio sta in un
            // <div class="errore"> nudo e non c'è niente da premere — <ErroreRiprova> su questa
            // pagina non compare in nessun ramo, a differenza di Home e dei tre registri, dove può
            // comparire. Nessun lavoro in sospeso da perdere: i due campi sono ancora vuoti,
            // questo è OnInitializedAsync.
            Console.Error.WriteLine($"[Spazi] Elenco non caricato: {ex.Message}");
            errore = "Non è stato possibile caricare i tuoi spazi: può essere la connessione, oppure la sessione che è scaduta. Ricarica la pagina, e se non basta esci e rientra.";
        }
        caricato = true;
    }

    private async Task Crea()
    {
        occupato = true;
        errore = null;
        try
        {
            var id = await Repository.CreaAsync(nuovoNome);
            nuovoNome = "";

            // Da qui in poi lo spazio ESISTE. Un fallimento dell'aggiornamento dell'elenco non
            // va riportato come "creazione non riuscita": l'utente riproverebbe, e create_space
            // non deduplica sul nome — si ritroverebbe due spazi identici. Si prosegue lo stesso,
            // perché la pagina di dettaglio carica i propri dati per conto suo.
            try
            {
                await Spazi.RicaricaAsync();
                Spazi.Imposta(id);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[Spazi] Elenco non aggiornato dopo la creazione: {ex.Message}");
            }

            Navigation.NavigateTo($"spaces/{id}");
        }
        catch (Exception ex)
        {
            // Il nome digitato è ancora nel campo: 'nuovoNome' si svuota solo dopo che CreaAsync è
            // andata a buon fine. La promessa vale solo su questa metà — sullo spazio non se ne fa
            // nessuna, perché fra "il database ha rifiutato" e "non è stato raggiunto" c'è anche il
            // caso della risposta persa dopo che l'INSERT è passata, e in quello lo spazio esiste
            // eccome: v. il commento nel try qui sopra, che spiega perché create_space non
            // deduplica sul nome.
            Console.Error.WriteLine($"[Spazi] Creazione dello spazio non riuscita: {ex.Message}");
            errore = "Non è stato possibile creare lo spazio: il database ha rifiutato la creazione, oppure non è stato raggiunto. Il nome che hai scritto è ancora qui: riprova fra un momento.";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Entra()
    {
        occupato = true;
        errore = null;
        try
        {
            var id = await Repository.EntraAsync(codice);
            if (id is null)
            {
                // Deliberatamente vago sul perché: dire "questo codice non esiste" permetterebbe
                // di provarne molti e scoprire quali sono validi.
                errore = "Codice non valido. Controlla di averlo copiato per intero.";
                return;
            }

            codice = "";

            // Come in Crea(): l'ingresso è già avvenuto, l'elenco è solo la vista.
            try
            {
                await Spazi.RicaricaAsync();
                Spazi.Imposta(id.Value);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[Spazi] Elenco non aggiornato dopo l'ingresso: {ex.Message}");
            }

            Navigation.NavigateTo($"spaces/{id.Value}");
        }
        catch (Exception ex)
        {
            // Il codice digitato è ancora nel campo: 'codice' si svuota solo dopo che EntraAsync è
            // andata a buon fine, quindi la promessa è vera in ogni ramo che arriva qui.
            Console.Error.WriteLine($"[Spazi] Ingresso nello spazio non riuscito: {ex.Message}");
            errore = "Non è stato possibile entrare nello spazio: il database ha rifiutato la richiesta, oppure non è stato raggiunto. Il codice che hai scritto è ancora qui: riprova fra un momento.";
        }
        finally
        {
            occupato = false;
        }
    }
}
