@page "/notes"
@using Eton.Models
@inherits PaginaRegistro
@inject NoteRepository Repository
@inject SpaceRepository SpaziRepository
@inject MarkdownRenderer Markdown

<PageTitle>Note — Eton</PageTitle>

<TestataPagina Titolo="Note">
    <Azione>
        @* Senza uno spazio attivo "Nuova nota" porterebbe a un modulo che non ha dove salvare, e la
           pagina mostra già il proprio invito ad andare negli spazi. *@
        @if (Spazi.Attivo is not null)
        {
            <a class="btn primario compatto" href="notes/new">Nuova nota</a>
        }
    </Azione>
    <Aiuto>
        <p>Le note si scrivono in Markdown, e l'anteprima mostra come vengono.</p>
        <p>In uno spazio condiviso le vedono tutti i membri; può modificarle o cancellarle chi le ha scritte, o chi possiede lo spazio.</p>
    </Aiuto>
</TestataPagina>

@if (!caricato)
{
    <Scheletro Righe="4" />
}
else if (Spazi.Attivo is null && errore is not null)
{
    <ErroreRiprova Messaggio="@errore" OnRiprova="Riprova" />
}
else if (Spazi.Attivo is null)
{
    <div class="vuoto">
        <p>Serve uno spazio prima di poter scrivere note.</p>
        <a class="btn primario" href="spaces">Vai agli spazi</a>
    </div>
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }

    <p class="sottotitolo">In <strong>@Spazi.Attivo.Name</strong></p>

    @* L'ordine conta: 'datiNonLetti' va provato PRIMA di 'note.Count == 0', perché l'elenco è vuoto
       in entrambi i casi e solo il flag distingue "non ci sono note" da "non ho potuto leggerle". *@
    @if (datiNonLetti)
    {
        <div class="vuoto">
            <p>Non sono riuscito a leggere le note di questo spazio.</p>
            <button class="btn" @onclick="Riprova">Riprova</button>
        </div>
    }
    else if (note.Count == 0)
    {
        @* Niente pulsante qui dentro: "Nuova nota" è già nella testata sopra, sempre visibile
           anche a registro vuoto. Duplicarlo qui darebbe due pulsanti uguali sullo stesso
           schermo, e chi guarda si chiederebbe se fanno cose diverse. *@
        <div class="vuoto">
            <span class="icona-vuoto"><Icona Nome="note" /></span>
            <p>Ancora nessuna nota qui.</p>
            <p class="spiega">Una nota si scrive in Markdown e resta nello spazio: appunti, liste di cose da fare, quello che non vuoi dimenticare.</p>
        </div>
    }
    else
    {
        <div class="testa-registro">
            <span>@Testi.Conteggio(note.Count, "nota", "note")</span>
        </div>
        <ul class="registro elenco-note">
            @foreach (var n in note)
            {
                <li>
                    <a class="riga riga-nota" href="notes/@n.Id">
                        <span class="titolo">@n.TitoloVisibile()</span>
                        @if (Estratto(n) is { Length: > 0 } estratto)
                        {
                            <span class="estratto">@estratto</span>
                        }
                        <span class="meta">
                            @if (Autore(n) is string autore)
                            {
                                <text>@autore · </text>
                            }
                            <span class="dato">@Testi.DataOra(n.UpdatedAt)</span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    private IReadOnlyList<Note> note = [];
    private IReadOnlyList<Membro> membri = [];

    protected override string NomePlurale => "le note";

    protected override async Task Leggi(Space attivo)
    {
        note = [];
        membri = [];

        try
        {
            note = await Repository.ElencaAsync(attivo.Id);
        }
        catch (Exception ex)
        {
            SegnalaNonLetti(ex);
            return;
        }

        // Solo negli spazi condivisi: in quello personale l'autore è sempre chi guarda, e
        // scriverne il nome accanto a ogni nota sarebbe rumore.
        if (attivo.IsPersonal) return;

        // Try separato, e non insieme alle note: i membri servono soltanto a scrivere il nome
        // dell'autore accanto a ogni nota. Metterli nello stesso catch faceva sì che un timeout su
        // questa seconda chiamata dichiarasse illeggibili delle note già lette benissimo, e le
        // nascondesse dietro un messaggio d'errore falso. Un fallimento qui lascia Autore() a null,
        // e la riga mostra la sola data — che è comunque l'informazione principale: non è un errore
        // da mostrare, ma va detto in console, altrimenti resta invisibile.
        try
        {
            membri = await SpaziRepository.MembriAsync(attivo.Id);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Note] Nomi degli autori non disponibili: {ex.Message}");
        }
    }

    private string Estratto(Note n)
    {
        var testo = Markdown.InTestoSemplice(n.Body).ReplaceLineEndings(" ").Trim();

        // Il ciclo non è quadratico: Replace sostituisce tutte le occorrenze non sovrapposte in un
        // passaggio solo, quindi ogni giro dimezza la lunghezza delle sequenze di spazi. Su 100.000
        // spazi consecutivi bastano 17 iterazioni.
        while (testo.Contains("  ")) testo = testo.Replace("  ", " ");

        if (testo.Length <= 120) return testo;

        // 120 sono unità UTF-16, non caratteri: un'emoji ne occupa due, e tagliare fra le due metà
        // di una coppia surrogata lascia mezzo carattere, che il browser disegna come glifo rotto.
        // Quando il taglio cadrebbe lì in mezzo si arretra di uno e si perde l'emoji intera.
        var fine = char.IsHighSurrogate(testo[119]) ? 119 : 120;
        return testo[..fine] + "…";
    }

    // Separato dalla data perché nel markup quella va in un <span class="dato"> a sé, per renderla
    // in carattere monospaziato: il nome di una persona non è un dato e non ci va. La data la scrive
    // Testi.DataOra — con l'ora, che qui serve: due modifiche nello stesso giorno sono la norma, e
    // la sola data non direbbe quale sia l'ultima.
    private string? Autore(Note n) => membri.FirstOrDefault(m => m.UtenteId == n.OwnerId)?.Nome;
}
