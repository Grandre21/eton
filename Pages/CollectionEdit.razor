@page "/collections/new"
@page "/collections/{Id:guid}/edit"
@using Eton.Models
@using Eton.Services
@inject CollectionRepository Repository
@inject SpaceStateService Spazi
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>@(string.IsNullOrWhiteSpace(nome) ? "Collezione" : nome) — Eton</PageTitle>

@if (!caricato)
{
    <p class="avvio">Caricamento…</p>
}
else if (sparita)
{
    <div class="vuoto">
        <p>Questa collezione non c'è più: l'ha cancellata qualcuno, oppure non fai più parte dello spazio.</p>
        <a class="btn" href="collections">Torna alle collezioni</a>
    </div>
}
else if (collezione is null && !Nuova)
{
    <div class="vuoto">
        <div class="errore" role="alert">@errore</div>
        <a class="btn" href="collections">Torna alle collezioni</a>
    </div>
}
else
{
    @if (errore is not null)
    {
        <div class="errore" role="alert">@errore</div>
    }
    @if (avviso is not null)
    {
        <div class="avviso" role="status">@avviso</div>
    }

    @if (conflitto is not null)
    {
        <div class="scheda pericolo">
            <h2>Qualcun altro ha salvato prima di te</h2>
            <p class="testo-tenue">
                Mentre modificavi, questa collezione è cambiata. Sovrascrivendo si perde il lavoro
                dell'altra persona; ricaricando si perde il tuo.
            </p>
            <div class="azioni">
                <button class="btn" @onclick="Ricarica" disabled="@occupato">Ricarica la sua</button>
                @* !PuoIntervenire in più: anche Sovrascrivi scrive nel database, e la RLS la
                   rifiuterebbe agli stessi soggetti a cui Salva è vietato — v. il commento su
                   PuoIntervenire più sotto. *@
                <button class="btn rosso" @onclick="Sovrascrivi" disabled="@(occupato || !PuoIntervenire)">Sovrascrivi con la mia</button>
            </div>
        </div>
    }

    @if (!PuoIntervenire)
    {
        <p class="spiega">@Permessi.Spiegazione(Permessi.Oggetto.Collezione)</p>
    }

    @if (Nuova && collezione is null)
    {
        <div class="scheda">
            <h2>Parti da un modello</h2>
            <p class="testo-tenue">Oppure compila da zero: i campi si aggiungono uno per uno.</p>
            <div class="azioni">
                @foreach (var m in modelli)
                {
                    <button class="btn piccolo" @onclick="() => ApplicaModello(m)" disabled="@(occupato || !PuoIntervenire)">@m.Icona @m.Nome</button>
                }
            </div>
        </div>
    }

    <input class="titolo-grande" type="text" placeholder="Nome della collezione" maxlength="100"
           @bind="nome" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />

    <label>
        <span class="etichetta-piccola">Icona</span>
        <input class="icona-input" type="text" placeholder="📋" maxlength="16"
               @bind="icona" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />
    </label>

    <label>
        @* Solo 5 e 10: il vincolo "check (rating_max in (5, 10))" della migrazione rifiuta ogni
           altro valore. Offrirne altre significherebbe far compilare l'utente per poi mostrargli
           un errore Postgres grezzo al salvataggio. *@
        <span class="etichetta-piccola">Scala dei voti</span>
        <select @bind="votoMassimo" disabled="@(occupato || !PuoIntervenire)">
            <option value="5">5</option>
            <option value="10">10</option>
        </select>
    </label>

    @* La spiegazione è lunga apposta: chi accende l'interruttore non subisce la conseguenza, la
       subiscono gli altri membri dello spazio quando aprono un elemento. Due parole non
       basterebbero a far capire a chi lo accende cosa cambia per qualcun altro. *@
    <label class="interruttore">
        <input type="checkbox" @bind="allaCieca" disabled="@(occupato || !PuoIntervenire)" />
        <span class="testi">
            <span class="titolo">Voto al buio</span>
            <span class="spiega">
                Chi apre un elemento non vede i voti degli altri finché non mette il suo: vede solo
                quante persone hanno recensito. Si può accendere e spegnere quando si vuole, e vale
                da subito su tutti gli elementi della collezione.
            </span>
        </span>
    </label>

    <div class="scheda">
        <h2>Campi</h2>
        <p class="testo-tenue">Le colonne che ogni elemento di questa collezione avrà.</p>

        @if (erroriValidazione.Count > 0)
        {
            <div class="errore" role="alert">
                <ul>
                    @foreach (var e in erroriValidazione)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <ul class="editor-campi">
            @* @key="campo.Key": senza, riordinando o cancellando un campo Blazor riusa gli elementi
               DOM per posizione, e il testo digitato in un input salta su un'altra riga.

               La chiave è l'oggetto stesso, non 'campo.Key': CampoDefinizione è una class senza
               override di Equals, quindi Blazor la confronta per riferimento e due campi restano
               distinti anche se portano la stessa Key. Serve perché il vincolo SQL su 'fields'
               controlla solo che sia un array di al massimo 40 elementi, mai la forma dei singoli
               campi, e il grant update(fields) lascia scrivere qualunque contenuto via PostgREST:
               con due chiavi uguali nel jsonb, @key="campo.Key" farebbe fallire il render proprio
               della pagina che serve a rimediare. *@
            @foreach (var campo in campi)
            {
                <li class="riga-campo" @key="campo">
                    <input type="text" maxlength="60" placeholder="Etichetta"
                           @bind="campo.Label" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />

                    <select @bind="campo.Type" @bind:after="() => AlCambioTipo(campo)" disabled="@(occupato || !PuoIntervenire)">
                        @foreach (var tipo in SchemaCampi.TipiAmmessi)
                        {
                            <option value="@tipo">@EtichettaTipo(tipo)</option>
                        }
                    </select>

                    @if (campo.Type == "select")
                    {
                        <div class="campo-opzioni">
                            @{ var opzioni = Opzioni(campo); }
                            @for (var i = 0; i < opzioni.Count; i++)
                            {
                                var indice = i;
                                <div class="campo">
                                    <input type="text" maxlength="60" @bind="opzioni[indice]" @bind:event="oninput" disabled="@(occupato || !PuoIntervenire)" />
                                    <button class="btn rosso piccolo" @onclick="() => TogliOpzione(campo, indice)" disabled="@(occupato || !PuoIntervenire)">Togli</button>
                                </div>
                            }
                            <button class="btn piccolo" @onclick="() => AggiungiOpzione(campo)" disabled="@(occupato || !PuoIntervenire)">Aggiungi opzione</button>
                        </div>
                    }

                    <div class="azioni">
                        <button class="btn piccolo" @onclick="() => Sposta(campo, -1)" disabled="@(occupato || !PuoIntervenire || campi[0] == campo)">↑</button>
                        <button class="btn piccolo" @onclick="() => Sposta(campo, 1)" disabled="@(occupato || !PuoIntervenire || campi[^1] == campo)">↓</button>

                        @if (campoDaRimuovere == campo.Key)
                        {
                            <span class="testo-tenue">I valori già inseriti per questo campo restano salvati ma non si vedranno più.</span>
                            <button class="btn rosso piccolo" @onclick="() => Rimuovi(campo)" disabled="@(occupato || !PuoIntervenire)">Sì, togli</button>
                            <button class="btn piccolo" @onclick="() => campoDaRimuovere = null" disabled="@(occupato || !PuoIntervenire)">Annulla</button>
                        }
                        else
                        {
                            <button class="btn rosso piccolo" @onclick="() => campoDaRimuovere = campo.Key" disabled="@(occupato || !PuoIntervenire)">Togli</button>
                        }
                    </div>
                </li>
            }
        </ul>

        <button class="btn" @onclick="AggiungiCampo" disabled="@(occupato || !PuoIntervenire || campi.Count >= SchemaCampi.MassimoCampi)">Aggiungi campo</button>
    </div>

    <div class="azioni">
        @* Anche 'conflitto is null', per lo stesso motivo di NoteEdit.razor:79-82: con la scheda del
           conflitto aperta il pulsante resterebbe acceso, perché lo stato è davvero diverso da
           quello di 'collezione'. Ripremerlo risalverebbe con la versione vecchia — stesso
           conflitto, altro giro a vuoto — e scavalcherebbe in silenzio la scelta fra Ricarica e
           Sovrascrivi, che è l'unico modo di uscirne. *@
        <button class="btn primario" @onclick="Salva" disabled="@(occupato || !Cambiata || conflitto is not null || !PuoIntervenire)">
            @(occupato ? "Salvo…" : "Salva")
        </button>
        <a class="btn" href="collections">Chiudi</a>

        @* PuoIntervenire in più, non solo !Nuova: Elimina sparisce del tutto, non si disabilita —
           un pulsante grigio inviterebbe comunque a chiedersi il motivo, e qui la risposta non
           starebbe da nessuna parte (v. il commento su PuoIntervenire più sotto). *@
        @if (!Nuova && PuoIntervenire)
        {
            @if (confermaEliminazione)
            {
                <span class="testo-tenue">Eliminando la collezione spariscono anche tutti i suoi elementi.</span>
                <button class="btn rosso" @onclick="Elimina" disabled="@occupato">Sì, elimina</button>
                <button class="btn" @onclick="() => confermaEliminazione = false" disabled="@occupato">Annulla</button>
            }
            else
            {
                <button class="btn rosso" @onclick="() => confermaEliminazione = true" disabled="@occupato">Elimina</button>
            }
        }
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Collection? collezione;   // l'ultima versione conosciuta dal server: da qui esce la versione
    private Collection? conflitto;    // la versione altrui, quando il salvataggio si è scontrato
    private string nome = "";
    private string icona = "";
    private short votoMassimo = 10;
    private bool allaCieca;
    private List<CampoDefinizione> campi = [];
    private IReadOnlyList<string> erroriValidazione = [];
    private bool caricato, occupato, sparita, confermaEliminazione;
    private string? errore, avviso;
    private int generazione;

    // La chiave del campo di cui è aperta la conferma di rimozione, o null se nessuna lo è: stessa
    // idea di 'confermaEliminazione' ma per riga, quindi serve un identificatore invece di un bool.
    private string? campoDaRimuovere;

    // SchemaCampi.Modelli alloca copie nuove a ogni accesso, di proposito (v. il commento lì):
    // leggerlo dentro il @foreach del markup ricostruirebbe tutto a ogni ridisegno. Va catturato
    // qui, una sola volta.
    private IReadOnlyList<ModelloCollezione> modelli = [];

    // L'id di chi guarda, come mioId in SpesaEdit.razor: stesso pattern, GetUserIdAsync() più
    // Guid.TryParse. Popolato in OnParametersSetAsync e non in OnInitializedAsync, a differenza di
    // SpesaEdit: qui il cambio di rotta da /collections/new a /collections/{id}/edit rilancia
    // OnParametersSetAsync su questa stessa istanza (v. il commento lì), quindi è quello il punto
    // in cui Spazi.Elenco va garantito pronto prima del render. Se il parsing fallisce resta null, e
    // PuoIntervenire qui sotto ne tiene conto fallendo chiuso.
    private Guid? mioId;

    private bool Nuova => Id is null;

    // La regola è comune a quattro entità (note, collezioni, elementi di collezione, spese): v.
    // Services/Permessi.cs per il perché di ogni scelta. Nuova per prima, ed è essenziale: su
    // /collections/new la collezione non esiste ancora, quindi chiedere "l'ho creata io?" di un
    // oggetto inesistente risponderebbe sempre no e bloccherebbe la creazione stessa.
    private bool PuoIntervenire => Nuova
        || (collezione is not null && Permessi.PuoIntervenire(mioId, collezione.OwnerId, collezione.SpaceId, Spazi.Elenco));

    // Come per il pulsante Salva di NoteEdit: resta spento finché non c'è niente da salvare.
    private bool Cambiata => Nuova
        ? !string.IsNullOrWhiteSpace(nome)
        : collezione is not null && (
            nome != collezione.Name ||
            icona != (collezione.Icon ?? "") ||
            votoMassimo != collezione.RatingMax ||
            allaCieca != collezione.Blind ||
            !CampiUguali(campi, collezione.Fields));

    protected override void OnInitialized()
    {
        modelli = SchemaCampi.Modelli;
    }

    // Come in NoteEdit: passando da /collections/new a /collections/{id}/edit dopo la creazione
    // Blazor riusa QUESTA istanza e cambia solo il parametro, quindi due caricamenti possono
    // sovrapporsi e quello partito prima può rispondere per ultimo.
    protected override async Task OnParametersSetAsync()
    {
        var mia = ++generazione;

        caricato = false;
        errore = avviso = null;
        conflitto = null;
        sparita = confermaEliminazione = false;
        campoDaRimuovere = null;
        erroriValidazione = [];

        // A differenza di SpesaEdit, questa pagina non ha un OnInitializedAsync che gira una sola
        // volta: usa deliberatamente OnParametersSetAsync (v. il commento sopra il metodo), quindi è
        // qui che Spazi.Elenco va garantito caricato prima che PuoIntervenire venga calcolato per il
        // render. Senza, su un collegamento diretto — Spazi.Elenco ancora vuoto — PuoIntervenire
        // fallirebbe chiuso e nasconderebbe i pulsanti anche a chi ha tutti i diritti di premerli:
        // peggio del difetto che si sta correggendo, perché un pulsante assente non segnala niente.
        try
        {
            await Spazi.AssicuraCaricatoAsync();
            if (Guid.TryParse(await AuthState.GetUserIdAsync(), out var id)) mioId = id;

            // I due await sopra sono punti di sospensione: da qui in poi non è più atomico
            // rispetto a una navigazione concorrente che riusa questa stessa istanza (v. il
            // commento sopra il metodo). Senza questo controllo, aprendo una collezione
            // esistente con rete lenta e poi navigando su /collections/new prima che
            // risponda, l'invocazione vecchia si risveglierebbe DOPO che l'utente ha già
            // iniziato a scrivere il nome nel modulo nuovo, rileggerebbe 'Nuova' come vera
            // ed eseguirebbe il ramo sotto — cancellando in silenzio il testo appena digitato.
            if (mia != generazione) return;

            if (Nuova)
            {
                collezione = null;
                nome = icona = "";
                votoMassimo = 10;
                allaCieca = false;
                campi = [];
                caricato = true;
                return;
            }

            var letta = await Repository.LeggiAsync(Id!.Value);
            if (mia != generazione) return;

            collezione = letta;
            if (collezione is null)
            {
                sparita = true;
            }
            else
            {
                CaricaDaCollezione(collezione);
            }
        }
        catch (Exception ex)
        {
            if (mia != generazione) return;

            // Non basta rimettere 'caricato = true': con 'collezione' non azzerata, su una
            // collezione esistente Spazi.Elenco resterebbe vuoto (è proprio AssicuraCaricatoAsync
            // ad aver fallito), PuoIntervenire fallirebbe chiuso, e l'utente vedrebbe il proprio
            // modulo con tutti i controlli in sola lettura — un guasto di rete travestito da "non
            // hai il permesso". Azzerando 'collezione' il render finisce invece nel ramo
            // "collezione is null && !Nuova" più sopra, che mostra l'errore al posto del modulo.
            collezione = null;
            errore = $"Non è stato possibile aprire la collezione: {ex.Message}";
        }

        caricato = true;
    }

    // Copia i CampoDefinizione invece di riferirli: l'editor li muta, e mutare direttamente quelli
    // di 'collezione' renderebbe Cambiata sempre falsa, perché confronterebbe un oggetto con sé
    // stesso.
    private void CaricaDaCollezione(Collection c)
    {
        nome = c.Name;
        icona = c.Icon ?? "";
        votoMassimo = c.RatingMax;
        allaCieca = c.Blind;
        // Ordina come fanno CollectionDetail e ItemEdit quando leggono lo stesso schema: se il jsonb
        // arriva con l'array fuori sequenza rispetto a Order — cosa che grant update(fields)
        // permette a chiunque scriva via PostgREST — l'editor mostrerebbe i campi in un ordine
        // diverso dalle altre due pagine, e il primo Sposta o Rimuovi ci chiamerebbe sopra
        // Rinumera(), fissando quell'ordine sbagliato per tutti.
        campi = SchemaCampi.Ordina(c.Fields).Select(CopiaCampo).ToList();
    }

    private static CampoDefinizione CopiaCampo(CampoDefinizione c) => new()
    {
        Key = c.Key,
        Label = c.Label,
        Type = c.Type,
        Options = c.Options is null ? null : new List<string>(c.Options),
        Order = c.Order
    };

    private static bool CampiUguali(IReadOnlyList<CampoDefinizione> a, IReadOnlyList<CampoDefinizione> b)
    {
        if (a.Count != b.Count) return false;

        for (var i = 0; i < a.Count; i++)
        {
            var x = a[i];
            var y = b[i];
            if (x.Key != y.Key || x.Label != y.Label || x.Type != y.Type || x.Order != y.Order) return false;
            if (!(x.Options ?? []).SequenceEqual(y.Options ?? [])) return false;
        }

        return true;
    }

    // I campi si copiano, anche se SchemaCampi.Modelli restituisce istanze fresche a ogni accesso:
    // qui l'accesso è avvenuto UNA volta sola, in OnInitialized, e 'modelli' resta in vita per tutta
    // la sessione. ToList() copierebbe il contenitore e non gli elementi, quindi cambiare il tipo di
    // un campo dopo aver applicato un modello muterebbe il modello stesso — e riapplicandolo, cosa
    // che la scheda permette finché la collezione non è salvata, si otterrebbe la versione già
    // corrotta invece di quella di partenza.
    private void ApplicaModello(ModelloCollezione modello)
    {
        nome = modello.Nome;
        icona = modello.Icona;
        campi = modello.Campi.Select(CopiaCampo).ToList();
        campoDaRimuovere = null;
    }

    // ChiaveDa si chiama SOLO qui, quando il campo nasce, e MAI quando l'etichetta viene rinominata
    // in seguito (l'input dell'etichetta, sopra, è legato direttamente a campo.Label e non tocca
    // campo.Key). I valori degli elementi sono salvati in collection_items.data sotto la chiave del
    // campo: se rinominando "Marca" in "Produttore" cambiasse anche la chiave da "marca" a
    // "produttore", tutti i valori già salvati resterebbero orfani sotto la vecchia chiave —
    // invisibili, non cancellati, e irrecuperabili senza una migrazione dei dati. L'etichetta è per
    // gli occhi, la chiave è l'identità.
    private void AggiungiCampo()
    {
        var giaUsate = campi.Select(c => c.Key).ToList();
        var chiave = SchemaCampi.ChiaveDa("", giaUsate);

        campi.Add(new CampoDefinizione
        {
            Key = chiave,
            Label = "",
            Type = "text",
            // Il massimo esistente più uno, non campi.Count + 1: gli Order caricati dal database
            // possono avere buchi, e contare gli elementi darebbe un Order già in uso da un altro
            // campo. Due Order uguali rendono Sposta un no-op silenzioso — scambierebbe due valori
            // identici, e Ordina, che è stabile, lascerebbe la lista com'era.
            Order = campi.Count == 0 ? 1 : campi.Max(c => c.Order) + 1
        });
    }

    private static string EtichettaTipo(string tipo) => tipo switch
    {
        "text" => "Testo",
        "number" => "Numero",
        "select" => "Scelta",
        "date" => "Data",
        "bool" => "Sì/No",
        "url" => "Collegamento",
        _ => tipo
    };

    private static void AlCambioTipo(CampoDefinizione campo)
    {
        // Valida rifiuta un campo non-select che porta opzioni: uscendo da select non ha più senso
        // tenerle. Entrando in select, invece, se ne prepara una lista vuota pronta da riempire.
        if (campo.Type == "select") campo.Options ??= [];
        else campo.Options = null;
    }

    private static List<string> Opzioni(CampoDefinizione campo) => campo.Options ??= [];

    private static void AggiungiOpzione(CampoDefinizione campo) => Opzioni(campo).Add("");

    private static void TogliOpzione(CampoDefinizione campo, int indice) => Opzioni(campo).RemoveAt(indice);

    // Scambia gli elementi nella lista e poi rinumera, invece di scambiare i due Order esistenti:
    // così lo spostamento non dipende da cosa c'era prima. Con due campi dello stesso Order — che
    // il vincolo SQL non impedisce — scambiare i valori significherebbe scambiare due numeri
    // uguali, e Ordina, che è stabile, lascerebbe la lista invariata: il pulsante non farebbe
    // niente e non lo direbbe.
    private void Sposta(CampoDefinizione campo, int direzione)
    {
        var indice = campi.IndexOf(campo);
        var vicino = indice + direzione;
        if (indice < 0 || vicino < 0 || vicino >= campi.Count) return;

        (campi[indice], campi[vicino]) = (campi[vicino], campi[indice]);
        Rinumera();
    }

    private void Rimuovi(CampoDefinizione campo)
    {
        campi.Remove(campo);
        campoDaRimuovere = null;
        Rinumera();
    }

    // Order = posizione nella lista, sempre da 1 a N senza buchi né duplicati. Rinumerare tocca solo
    // Order, mai Key: la chiave resta l'identità del campo e i valori già salvati negli elementi
    // continuano a trovarla.
    private void Rinumera()
    {
        for (var i = 0; i < campi.Count; i++) campi[i].Order = i + 1;
    }

    private async Task Salva()
    {
        occupato = true; errore = avviso = null; conflitto = null;
        try
        {
            // Valida PRIMA di scrivere: il database rifiuterebbe comunque uno schema scorretto, ma
            // con un messaggio Postgres grezzo. Qui l'utente legge quale campo correggere.
            //
            // Il nome va controllato qui e non basta 'Cambiata': su una collezione esistente,
            // svuotare il nome la rende diversa da quella salvata, quindi il pulsante Salva si
            // accende — e SchemaCampi.Valida guarda solo i campi. Senza questa riga, il vincolo
            // check (length(btrim(name)) between 1 and 100) della migrazione respingerebbe la
            // scrittura e l'utente leggerebbe un messaggio di Postgres invece di una frase.
            var errori = new List<string>();
            if (string.IsNullOrWhiteSpace(nome)) errori.Add("Il nome della collezione non può essere vuoto.");
            errori.AddRange(SchemaCampi.Valida(campi).Errori);

            erroriValidazione = errori;
            if (erroriValidazione.Count > 0) return;

            if (Nuova)
            {
                await Crea();
                return;
            }

            await SalvaCon(collezione!.Version);
        }
        catch (Exception ex)
        {
            errore = $"Non è stato possibile salvare: {ex.Message}";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Crea()
    {
        var attivo = await Spazi.AssicuraCaricatoAsync();
        if (attivo is null)
        {
            errore = "Serve uno spazio attivo per creare una collezione.";
            return;
        }

        if (!Guid.TryParse(await AuthState.GetUserIdAsync(), out var autore))
        {
            errore = "La sessione non è più valida: esci e rientra.";
            return;
        }

        var creata = await Repository.CreaAsync(attivo.Id, autore, nome, icona, campi, votoMassimo, allaCieca);

        // replace: true per lo stesso motivo di NoteEdit.razor:209-212: /collections/new non è un
        // posto in cui tornare col tasto Indietro — la collezione ormai esiste, e ripresentare la
        // schermata vuota ne farebbe creare una seconda. Il cambio di rotta rilancia
        // OnParametersSetAsync su questa stessa istanza, che rilegge la collezione: solo da quel
        // momento c'è una versione con cui fare concorrenza ottimistica.
        Navigation.NavigateTo($"collections/{creata.Id}/edit", replace: true);
    }

    private async Task SalvaCon(int versione)
    {
        var esito = await Repository.SalvaAsync(Id!.Value, versione, nome, icona, campi, votoMassimo, allaCieca);

        switch (esito.Esito)
        {
            case EsitoSalvataggio.Salvata:
                collezione = esito.Aggiornata;
                CaricaDaCollezione(collezione!);
                avviso = "Salvata.";
                break;

            case EsitoSalvataggio.Conflitto:
                conflitto = esito.Aggiornata;
                break;

            case EsitoSalvataggio.Rifiutata:
                // Con PuoIntervenire attivo, arrivare qui vuol dire che quel pre-controllo si è
                // rivelato sbagliato o stantio — per esempio la proprietà dello spazio è cambiata
                // mentre la pagina era aperta. È l'unico punto in cui non si può affermare la
                // regola con sicurezza, quindi non la si riscrive qui: si dice il fatto, si
                // suggerisce la causa senza giurarci, e si indica l'azione.
                errore = "Non hai più il permesso di modificare questa collezione: può essere cambiato qualcosa nello spazio. Ricarica la pagina.";
                break;

            case EsitoSalvataggio.Sparita:
                sparita = true;
                break;
        }
    }

    private void Ricarica()
    {
        if (conflitto is null) return;

        collezione = conflitto;
        CaricaDaCollezione(conflitto);
        conflitto = null;
        // Anche la conferma di rimozione va azzerata: 'campi' è stato appena sostituito, e una
        // conferma rimasta aperta si riferirebbe a un campo di un elenco che non esiste più.
        campoDaRimuovere = null;
        avviso = "Caricata la versione più recente.";
    }

    private async Task Sovrascrivi()
    {
        if (conflitto is null) return;

        occupato = true; errore = null;
        try
        {
            // Si risalva con la versione DEL SERVER, non con quella che si aveva in mano: è
            // esattamente ciò che "sovrascrivi" vuol dire — prendere atto che l'altro ha scritto
            // e scriverci sopra lo stesso. Se nel frattempo arriva un terzo salvataggio questo
            // fallisce di nuovo con Conflitto, ed è il comportamento giusto.
            var versione = conflitto.Version;
            conflitto = null;
            await SalvaCon(versione);
        }
        catch (Exception ex)
        {
            errore = $"Non è stato possibile sovrascrivere: {ex.Message}";
        }
        finally
        {
            occupato = false;
        }
    }

    private async Task Elimina()
    {
        occupato = true; errore = null;
        try
        {
            if (await Repository.EliminaAsync(Id!.Value))
            {
                Navigation.NavigateTo("collections");
                return;
            }
            errore = "Non è stato possibile eliminare la collezione.";
        }
        catch (Exception ex)
        {
            errore = $"Non è stato possibile eliminare: {ex.Message}";
        }
        finally
        {
            occupato = false;
            confermaEliminazione = false;
        }
    }
}
